---
import { withBase } from '../../lib/withBase';

const home = withBase('/v2/');
const logo = withBase('/brand/conecta-1b-nodo-horizontal.svg');
const links = [
  { href: `${home}#inicio`, label: 'Inicio' },
  { href: `${home}#sobre-mi`, label: 'Sobre mí' },
  { href: `${home}#servicios`, label: 'Servicios' },
  { href: `${home}#como-funciona`, label: 'Cómo funciona' },
  { href: `${home}#faq`, label: 'Preguntas' },
  { href: `${home}#contacto`, label: 'Contacto' },
];
---

<header class="sticky top-4 z-40 px-4">
  <div class="mx-auto flex max-w-3xl items-center justify-between rounded-full border border-navy-100 bg-white/90 px-5 py-3 shadow-[0_8px_30px_-12px_rgba(42,63,106,0.25)] backdrop-blur">
    <a href={home} class="block">
      <img src={logo} alt="Clínica Conecta" width="153" height="48" class="h-8 w-auto" />
    </a>

    <nav class="hidden gap-6 font-v2-sans text-sm text-ink/70 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="transition-colors duration-150 ease-[var(--ease-out)] hover:text-navy-800"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="menu-mobile"
      class="flex h-9 w-9 items-center justify-center rounded-full text-navy-800 md:hidden"
      aria-label="Abrir menú"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="h-6 w-6"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav
    id="menu-mobile"
    class="invisible absolute inset-x-4 top-full mt-2 -translate-y-2 rounded-2xl border border-navy-100 bg-white p-5 opacity-0 shadow-[0_12px_40px_-12px_rgba(42,63,106,0.3)] transition-[opacity,transform,visibility] duration-200 ease-[var(--ease-out)] md:hidden data-open:visible data-open:translate-y-0 data-open:opacity-100"
  >
    <ul class="flex flex-col gap-4 font-v2-sans text-sm text-ink/70">
      {links.map((link) => (
        <li>
          <a href={link.href} class="block">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.hasAttribute('data-open') === true;
    menu?.toggleAttribute('data-open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.removeAttribute('data-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
