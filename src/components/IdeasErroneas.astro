---
// Ideas erróneas frecuentes sobre un enfoque, en tarjetas «Se suele pensar /
// En realidad». Resuelven las dudas típicas dentro del texto, sin acordeón.
interface Props {
  ideas: { creencia: string; realidad: string }[];
}

const { ideas } = Astro.props;
---

<ul class="mt-6 grid gap-4">
  {ideas.map((idea) => (
    <li class="grid overflow-hidden rounded-2xl border border-navy-100 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
      <div class="bg-cream-50 p-5">
        <p class="text-xs font-medium tracking-[0.12em] text-navy-600 uppercase">Se suele pensar</p>
        <p class="mt-2 font-serif text-lg leading-snug font-semibold text-balance text-navy-800">
          «{idea.creencia}»
        </p>
      </div>
      <div class="border-t border-navy-100 bg-white p-5 sm:border-t-0 sm:border-l">
        <p class="flex items-center gap-2 text-xs font-medium tracking-[0.12em] text-navy-600 uppercase">
          <span class="h-1 w-4 shrink-0 bg-gold-400" aria-hidden="true" />
          En realidad
        </p>
        <p class="mt-2 text-sm leading-relaxed text-pretty text-ink/80">{idea.realidad}</p>
      </div>
    </li>
  ))}
</ul>
