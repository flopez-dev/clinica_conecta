---
interface Props {
  href: string;
  /** Rótulo en una burbuja a la izquierda del círculo (p. ej. "Hablemos"). Sin él, solo el círculo. En móvil (< sm) la burbuja se oculta: tapaba el CTA del hero. */
  etiqueta?: string;
}

const { href, etiqueta } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={etiqueta ? `${etiqueta} por WhatsApp` : 'Escribir por WhatsApp'}
  class:list={[
    'fixed right-5 bottom-5 z-50 flex items-center gap-3 rounded-full transition-transform duration-150 ease-[var(--ease-out)] hover:scale-105 active:scale-95',
    { 'origin-right': etiqueta },
  ]}
>
  {etiqueta && (
    <span class="relative hidden rounded-lg bg-white px-4 py-1 text-base leading-6 text-ink shadow-md sm:block">
      {etiqueta}
      <span
        class="absolute top-1/2 right-0 size-1.5 -translate-y-1/2 translate-x-1/2 rotate-45 bg-white"
        aria-hidden="true"
      />
    </span>
  )}
  <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg">
    <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.71.45 3.38 1.3 4.85L2 22l5.36-1.4a9.9 9.9 0 0 0 4.68 1.19h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.85 9.85 0 0 0 12.04 2Zm0 18.12h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.25-4.35c0-4.55 3.7-8.25 8.26-8.25 2.2 0 4.28.86 5.84 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.55-3.71 8.21-8.27 8.21Zm4.52-6.16c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.96-.14.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.24.24-.4.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42-.14 0-.31-.01-.47-.01-.16 0-.43.06-.65.31-.23.24-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.16 1.73 2.64 4.2 3.7.59.25 1.05.4 1.4.52.59.19 1.13.16 1.55.1.47-.07 1.46-.6 1.67-1.17.2-.58.2-1.07.14-1.17-.06-.1-.22-.16-.47-.28Z"></path>
    </svg>
  </span>
</a>
