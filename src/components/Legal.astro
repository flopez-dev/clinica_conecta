---
// Maqueta de las páginas legales: header, cabecera azul, índice de apartados y
// cierre con la sección de contacto.
import Header from './Header.astro';
import Cabecera from './Cabecera.astro';
import Contacto from './Contacto.astro';
import Revelar from './Revelar.astro';
import { withBase } from '../lib/withBase';
import type { Apartado } from '../lib/apartados';
import { curva, enlace, foco } from '../lib/estilo';

interface Props {
  titulo: string;
  entradilla: string;
  /** Última revisión del texto (no del despliegue), p. ej. "25 de septiembre de 2026". */
  actualizado: string;
  apartados: Apartado[];
  /** La otra página legal, enlazada desde la cabecera. */
  otra: { href: string; texto: string };
}

const { titulo, entradilla, actualizado, apartados, otra } = Astro.props;
---

<Header />

<main class="text-ink">
  <Cabecera rotulo="Información legal" titulo={titulo}>
    <p class="animate-hero-in mt-5 max-w-2xl text-lg text-pretty text-cream-50/85 [animation-delay:80ms]">
      {entradilla}
    </p>
    <div class="animate-hero-in mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 [animation-delay:160ms]">
      <p class="flex items-center gap-2 text-xs tracking-[0.12em] text-cream-50/70 uppercase">
        <span class="h-1 w-4 shrink-0 bg-gold-400" aria-hidden="true"></span>
        Actualizado el {actualizado}
      </p>
      <a
        href={otra.href}
        class={`rounded-sm text-sm text-cream-50/80 underline decoration-gold-400 underline-offset-4 transition-colors duration-300 ${curva} hover:text-cream-50 ${foco}`}
      >
        {otra.texto}
      </a>
    </div>
  </Cabecera>

  <div class="bg-white px-6 py-16 sm:py-20">
    <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-16">
      <!-- Índice: en móvil, tarjeta al principio; desde md, columna fija bajo el header -->
      <nav
        aria-labelledby="indice-titulo"
        data-indice
        class="self-start rounded-2xl bg-cream-50 p-6 md:sticky md:top-28 md:bg-transparent md:p-0"
      >
        <p
          id="indice-titulo"
          class="font-serif text-sm font-semibold tracking-[0.1em] text-navy-800 uppercase"
        >
          En esta página
        </p>
        <ol class="mt-4 space-y-1 border-l border-navy-100 text-sm">
          {apartados.map((a) => (
            <li>
              <a
                href={`#${a.id}`}
                class={`-ml-px flex gap-2 rounded-sm border-l-2 border-transparent py-1 pl-4 leading-snug text-ink/70 transition-colors duration-300 ${curva} hover:text-navy-600 aria-[current=true]:border-gold-400 aria-[current=true]:font-medium aria-[current=true]:text-navy-800 ${foco}`}
              >
                <span class="w-6 shrink-0 text-navy-600 tabular-nums">{a.numero}.</span>
                {a.titulo}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div data-legal class="max-w-prose min-w-0 space-y-14">
        <slot />

        <p class="border-t border-navy-100 pt-8 text-sm">
          <a href={withBase('/')} class={`inline-flex items-center gap-2 text-navy-800 ${enlace}`}>
            <svg viewBox="0 0 256 256" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M224 128a8 8 0 0 1-8 8H59.31l58.35 58.34a8 8 0 0 1-11.32 11.32l-72-72a8 8 0 0 1 0-11.32l72-72a8 8 0 0 1 11.32 11.32L59.31 120H216a8 8 0 0 1 8 8"></path>
            </svg>
            Volver al inicio
          </a>
        </p>
      </div>
    </div>
  </div>

  <Contacto />
</main>

<Revelar />

<script>
  // Marca en el índice el apartado que se está leyendo. La franja de
  // observación empieza bajo el header fijo y ocupa el tercio superior.
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-indice] a')];
  const porId = new Map(enlaces.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        enlaces.forEach((a) => a.removeAttribute('aria-current'));
        porId.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-120px 0px -65% 0px' },
  );

  document.querySelectorAll('[data-legal] > section[id]').forEach((s) => io.observe(s));
</script>
