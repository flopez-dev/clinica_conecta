---
import { withBase } from '../lib/withBase';

const home = withBase('/');
const logoClaro = withBase('/brand/conecta-1b-nodo-horizontal.svg');
const logoOscuro = withBase('/brand/conecta-1b-nodo-horizontal-oscuro.svg');
const links = [
  { href: `${home}#inicio`, label: 'Inicio' },
  { href: `${home}#sobre-mi`, label: 'Sobre mí' },
  { href: `${home}#servicios`, label: 'Servicios' },
  { href: `${home}#como-funciona`, label: 'Sesiones' },
  { href: `${home}#tarifas`, label: 'Tarifas' },
  { href: `${home}#faq`, label: 'Preguntas' },
  { href: `${home}#contacto`, label: 'Contacto', destacado: true },
];

const boton =
  'rounded-md bg-gold-400 px-4 py-2 font-medium text-navy-900 transition-[filter,transform] duration-150 ease-[var(--ease-out)] hover:brightness-105 active:scale-[0.98]';
const enlace =
  'text-ink/80 transition-colors duration-300 hover:text-navy-600 motion-reduce:transition-none group-[.is-solid]:text-cream-50/85 group-[.is-solid]:hover:text-white';
---

<!--
  Sobre el hero (azul) el header es crema. Al salir del hero el script de abajo
  añade `.is-solid` y todo pasa a azul, para que nunca haya crema sobre secciones
  claras. En las páginas sin hero (#inicio) se queda siempre crema.
-->

<header
  id="site-header"
  class="group sticky top-0 z-40 border-b border-navy-100 bg-cream-50/95 backdrop-blur transition-colors duration-300 motion-reduce:transition-none [&.is-solid]:border-navy-600/60 [&.is-solid]:bg-navy-800/95"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={home} class="relative block h-9 w-[115px]">
      <img
        src={logoClaro}
        alt="Clínica Conecta"
        width="153"
        height="48"
        class="absolute inset-0 h-9 w-auto transition-opacity duration-300 motion-reduce:transition-none group-[.is-solid]:opacity-0"
      />
      <img
        src={logoOscuro}
        alt=""
        width="153"
        height="48"
        class="absolute inset-0 h-9 w-auto opacity-0 transition-opacity duration-300 motion-reduce:transition-none group-[.is-solid]:opacity-100"
      />
    </a>

    <nav class="hidden items-center gap-6 text-sm md:flex">
      {links.map((link) => (
        <a href={link.href} class={link.destacado ? boton : enlace}>
          {link.label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="menu-mobile"
      class="flex h-9 w-9 items-center justify-center rounded-md text-navy-800 transition-colors duration-300 group-[.is-solid]:text-cream-50 motion-reduce:transition-none md:hidden"
      aria-label="Abrir menú"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="h-6 w-6"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav
    id="menu-mobile"
    class="invisible absolute inset-x-0 top-full -translate-y-2 border-t border-navy-100 bg-cream-50 px-6 py-4 opacity-0 transition-[opacity,transform,visibility,background-color] duration-200 ease-[var(--ease-out)] group-[.is-solid]:border-navy-600/60 group-[.is-solid]:bg-navy-800 md:hidden data-open:visible data-open:translate-y-0 data-open:opacity-100"
  >
    <ul class="flex flex-col items-start gap-4 text-sm">
      {links.map((link) => (
        <li>
          <a href={link.href} class={`${link.destacado ? boton : enlace} inline-block`}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.hasAttribute('data-open') === true;
    menu?.toggleAttribute('data-open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.removeAttribute('data-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // El margen superior negativo es la altura del header: el hero "sale" en el
  // momento en que ya no queda nada de él bajo la barra.
  const header = document.getElementById('site-header');
  const hero = document.getElementById('inicio');

  if (header && hero) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-solid', !entry.isIntersecting),
      { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
    ).observe(hero);
  }
</script>
