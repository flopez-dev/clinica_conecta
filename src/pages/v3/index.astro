---
import Base from '../../layouts/Base.astro';
import Header from '../../components/v3/Header.astro';
import Footer from '../../components/v3/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { withBase } from '../../lib/withBase';

const title = 'Propuesta 3 · Ir y venir, hasta encontrar calma · Clínica Conecta';
const description =
  'Juan Ignacio Riccardi, Psicólogo General Sanitario. Terapia online en español para adolescentes, adultos y parejas, con EMDR. Sesiones de 50 minutos.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const whatsappMessage = encodeURIComponent('Hola, me gustaría agendar una sesión');
const whatsappHref = `https://wa.me/34644751041?text=${whatsappMessage}`;
const llamadaMessage = encodeURIComponent(
  'Hola, me gustaría pedir la primera llamada gratuita de 15 minutos',
);
const llamadaHref = `https://wa.me/34644751041?text=${llamadaMessage}`;
const tarifaMessage = encodeURIComponent('Hola, me gustaría conocer la tarifa de las sesiones');
const tarifaHref = `https://wa.me/34644751041?text=${tarifaMessage}`;
const mailtoHref = 'mailto:riccardijuanpsi@gmail.com?subject=Consulta%20desde%20la%20web';
const linkedinHref = 'https://www.linkedin.com/in/juaniriccardi';
const fotoCuadrada = withBase('/foto/juan-ignacio-cuadrada-2.webp');

// Juan es la entidad principal, no un negocio local. `ProfessionalService`
// es un subtipo de LocalBusiness, o sea de Place, y daba a entender que hay
// una sede física: no la hay, la consulta es solo online desde Argentina.
// Se modela como Person que presta un Service, con la marca colgando del
// servicio.
const persona = {
  '@type': 'Person',
  '@id': `${canonical}#juan`,
  name: 'Juan Ignacio Riccardi',
  jobTitle: 'Psicólogo General Sanitario',
  description,
  url: canonical,
  image: new URL(withBase('/og-image-v3.png'), Astro.site).toString(),
  telephone: '+34644751041',
  email: 'riccardijuanpsi@gmail.com',
  knowsLanguage: 'es',
  knowsAbout: ['EMDR', 'Ansiedad', 'Estrés', 'Duelo', 'Depresión', 'Terapia de pareja'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad del Salvador' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad de Belgrano' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Aconcagua' },
  ],
  sameAs: [
    'https://wa.me/34644751041',
    'https://www.instagram.com/juanriccardi.conecta/',
    'https://www.facebook.com/share/1Czzsw5wiS/',
    linkedinHref,
  ],
};

const servicio = {
  '@type': 'Service',
  name: 'Terapia psicológica online en español',
  serviceType: 'Psicoterapia online',
  provider: { '@id': `${canonical}#juan` },
  brand: { '@type': 'Brand', name: 'Clínica Conecta' },
  areaServed: 'España',
  audience: { '@type': 'Audience', audienceType: 'Adolescentes, adultos y parejas' },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: canonical,
    availableLanguage: 'es',
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [persona, servicio],
};

const servicios = [
  {
    titulo: 'Ansiedad',
    texto:
      'Cuando la mente se adelanta y el cuerpo se queda en alerta. Trabajamos para bajar ese ritmo, con herramientas concretas.',
  },
  {
    titulo: 'Estrés',
    texto:
      'Cuando las exigencias se acumulan más rápido de lo que puedes soltarlas. Vemos qué lo alimenta y trabajamos recursos para un ritmo sostenible.',
  },
  {
    titulo: 'Duelo',
    texto:
      'Un proceso que no se apura. Acompaño ese ir y venir entre el recuerdo y el presente, con espacio para todo lo que aparezca.',
  },
  {
    titulo: 'Depresión',
    texto: 'Cuando faltan las ganas de moverse. Empezamos por pasos pequeños, a tu ritmo.',
  },
  {
    titulo: 'Adolescentes',
    texto:
      'Una edad de idas y vueltas. Un espacio propio, con la mirada de quien lleva años en equipos de orientación escolar.',
  },
  {
    titulo: 'Parejas',
    texto:
      'Para los dos, en la misma llamada. Revisamos qué se dice, qué se calla y qué hace falta cambiar.',
  },
];

const confianza = [
  'Psicólogo General Sanitario',
  'Ejerciendo desde 2017',
  'Formación en EMDR, Instituto Español de EMDR',
  'Primera llamada gratuita de 15 minutos',
];

const formacion = [
  {
    anio: '2013 a 2017',
    titulo: 'Licenciatura en Psicología',
    detalle: 'Universidad del Salvador, Argentina.',
  },
  {
    anio: '2024',
    titulo: 'Máster en Psicología General Sanitaria',
    detalle: 'Título homologado en España.',
  },
  {
    anio: 'Formación clínica',
    titulo: 'EMDR Nivel 1',
    detalle: 'Instituto Español de EMDR, Barcelona.',
  },
  {
    anio: 'Posgrado',
    titulo: 'Terapia Cognitivo Conductual',
    detalle: 'Universidad de Belgrano, Argentina.',
  },
  {
    anio: 'Posgrado',
    titulo: 'Terapia Dialéctico Conductual',
    detalle: 'Universidad Aconcagua, Argentina.',
  },
  {
    anio: 'En paralelo',
    titulo: 'Docencia',
    detalle: 'Psicología y salud mental en nivel secundario y superior.',
  },
];

// Sesiones: curva con masa (skill /landing-page-design) y anillo de foco visible.
const curva = 'ease-[cubic-bezier(0.32,0.72,0,1)]';
const foco =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-400';

// Icono de WhatsApp (Phosphor, viewBox 256) del botón de tarifa.
const iconoWhatsApp =
  'm187.58 144.84l-32-16a8 8 0 0 0-8 .5l-14.69 9.8a40.55 40.55 0 0 1-16-16l9.8-14.69a8 8 0 0 0 .5-8l-16-32A8 8 0 0 0 104 64a40 40 0 0 0-40 40a88.1 88.1 0 0 0 88 88a40 40 0 0 0 40-40a8 8 0 0 0-4.42-7.16M152 176a72.08 72.08 0 0 1-72-72a24 24 0 0 1 19.29-23.54l11.48 23L101 118a8 8 0 0 0-.73 7.51a56.47 56.47 0 0 0 30.15 30.15A8 8 0 0 0 138 155l14.61-9.74l23 11.48A24 24 0 0 1 152 176M128 24a104 104 0 0 0-91.82 152.88l-11.35 34.05a16 16 0 0 0 20.24 20.24l34.05-11.35A104 104 0 1 0 128 24m0 192a87.87 87.87 0 0 1-44.06-11.81a8 8 0 0 0-6.54-.67L40 216l12.47-37.4a8 8 0 0 0-.66-6.54A88 88 0 1 1 128 216';

// Iconos Phosphor (viewBox 256) de las condiciones del servicio, en línea para no añadir dependencias.
const iconosPh: Record<string, string> = {
  creditCard:
    'M224 48H32a16 16 0 0 0-16 16v128a16 16 0 0 0 16 16h192a16 16 0 0 0 16-16V64a16 16 0 0 0-16-16m0 16v24H32V64Zm0 128H32v-88h192zm-16-24a8 8 0 0 1-8 8h-32a8 8 0 0 1 0-16h32a8 8 0 0 1 8 8m-64 0a8 8 0 0 1-8 8h-16a8 8 0 0 1 0-16h16a8 8 0 0 1 8 8',
  calendarX:
    'M208 32h-24v-8a8 8 0 0 0-16 0v8H88v-8a8 8 0 0 0-16 0v8H48a16 16 0 0 0-16 16v160a16 16 0 0 0 16 16h160a16 16 0 0 0 16-16V48a16 16 0 0 0-16-16M72 48v8a8 8 0 0 0 16 0v-8h80v8a8 8 0 0 0 16 0v-8h24v32H48V48Zm136 160H48V96h160zm-50.34-74.34L139.31 152l18.35 18.34a8 8 0 0 1-11.32 11.32L128 163.31l-18.34 18.35a8 8 0 0 1-11.32-11.32L116.69 152l-18.35-18.34a8 8 0 0 1 11.32-11.32L128 140.69l18.34-18.35a8 8 0 0 1 11.32 11.32',
  clock:
    'M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24m0 192a88 88 0 1 1 88-88a88.1 88.1 0 0 1-88 88m64-88a8 8 0 0 1-8 8h-56a8 8 0 0 1-8-8V72a8 8 0 0 1 16 0v48h48a8 8 0 0 1 8 8',
  videoCamera:
    'M251.77 73a8 8 0 0 0-8.21.39L208 97.05V72a16 16 0 0 0-16-16H32a16 16 0 0 0-16 16v112a16 16 0 0 0 16 16h160a16 16 0 0 0 16-16v-25l35.56 23.71A8 8 0 0 0 248 184a8 8 0 0 0 8-8V80a8 8 0 0 0-4.23-7M192 184H32V72h160zm48-22.95l-32-21.33v-23.44L240 95Z',
};

// Sesiones: de V1.
const paraQuienEs = [
  'Sientes ansiedad o estrés que no consigues gestionar por tu cuenta.',
  'Atraviesas un duelo o una pérdida reciente.',
  'Notas síntomas de depresión o desmotivación persistente.',
  'Eres madre, padre o tutor y buscas apoyo para un adolescente.',
  'Como pareja, queréis recuperar una forma de hablar que se ha roto.',
  'Prefieres la comodidad y la privacidad de la terapia online.',
];

const pasos = [
  {
    numero: '1',
    titulo: 'Escríbeme',
    texto:
      'Cuéntame por WhatsApp, en pocas palabras, qué te trae a terapia. Si prefieres hablar antes, empezamos con una primera llamada gratuita de 15 minutos.',
  },
  {
    numero: '2',
    titulo: 'Sesión online',
    texto:
      'Videollamada de 50 minutos, en un espacio privado y confidencial, por Google Meet, Zoom o WhatsApp.',
  },
  {
    numero: '3',
    titulo: 'Seguimiento',
    texto:
      'Avanzamos sesión a sesión, ajustando el enfoque y las herramientas a tu proceso y tu ritmo.',
  },
];

// Condiciones del servicio. No se muestran importes por decisión del cliente (ver
// CLAUDE.md): el botón de la sección remite a WhatsApp. `destacado` es un fragmento
// de `valor` que se pinta en azul y negrita.
const condiciones: { icono: string; clave: string; valor: string; destacado?: string }[] = [
  { icono: 'creditCard', clave: 'Forma de pago', valor: 'Bizum o transferencia bancaria.' },
  {
    icono: 'calendarX',
    clave: 'Cancelaciones',
    valor: 'Deben comunicarse con 48\u00a0horas de antelación.',
    destacado: '48\u00a0horas',
  },
  {
    icono: 'videoCamera',
    clave: 'Plataformas',
    valor: 'Google Meet, Zoom o WhatsApp, a tu elección.',
  },
  { icono: 'clock', clave: 'Horarios', valor: 'Amplia disponibilidad horaria.' },
];

const enfoques = [
  {
    titulo: 'TCC (Terapia Cognitivo-Conductual)',
    texto:
      'Parte de una idea sencilla: no son los hechos los que nos hacen sufrir, sino cómo los interpretamos y lo que hacemos a partir de ahí. Es un enfoque práctico y estructurado: identificamos juntos esos pensamientos que no te ayudan, como pensar "todo me va a salir mal" tras un solo contratiempo, y los sustituimos por formas de pensar más realistas. También vamos cambiando, poco a poco, los comportamientos que mantienen tu malestar, como evitar situaciones por miedo. Es especialmente eficaz para la ansiedad, la depresión y el estrés, y suele dar resultados visibles en relativamente poco tiempo.',
  },
  {
    titulo: 'EMDR',
    texto:
      'Es una terapia que ayuda a tu cerebro a "digerir" recuerdos o experiencias difíciles que se han quedado atascados y te siguen afectando en el presente, aunque haya pasado tiempo: ansiedad, pesadillas o reacciones desproporcionadas ante ciertas situaciones. Durante la sesión, mientras recuerdas brevemente esa experiencia, te guío a través de un tipo de estimulación (normalmente con movimientos oculares) que ayuda a tu cerebro a procesar ese recuerdo de una forma más sana. No se trata de olvidar lo ocurrido, sino de que deje de doler y de condicionar tu día a día.',
  },
];

const faqs = [
  {
    pregunta: '¿La terapia online es tan eficaz como la presencial?',
    respuesta:
      'Sí: la evidencia respalda que la terapia por videollamada logra resultados comparables a la presencial, como en la ansiedad, la depresión o el estrés. Solo necesitas una conexión estable y un sitio donde puedas hablar con tranquilidad.',
  },
  {
    pregunta: '¿Qué problemas trabajas y desde qué enfoque?',
    respuesta:
      'Trabajo la ansiedad, el estrés, el duelo y la depresión, y acompaño a adolescentes y a parejas. Combino la terapia cognitivo-conductual, práctica y estructurada, con EMDR para recuerdos difíciles que te siguen afectando. Ajusto las herramientas a tu proceso y a tu ritmo.',
  },
  {
    pregunta: '¿En qué casos no es recomendable la terapia online?',
    respuesta:
      'No es el recurso adecuado en una crisis o emergencia, si hay riesgo de autolesión o de hacer daño a otras personas, ni cuando hace falta atención presencial o psiquiátrica urgente. En esos casos, llama al 024 (atención a la conducta suicida) o al 112 (emergencias); si sufres violencia de género, al 016. Y si dudas de si tu caso encaja, cuéntamelo y te oriento con honestidad.',
  },
  {
    pregunta: '¿Estás colegiado y tienes habilitación sanitaria?',
    respuesta:
      'Soy Licenciado en Psicología por la Universidad del Salvador (Argentina) y Psicólogo General Sanitario en España, por título homologado en 2024. Estoy colegiado con el número 68849 en Argentina.',
  },
  {
    pregunta: '¿Cómo reservo la primera cita?',
    respuesta:
      'Escríbeme por WhatsApp desde el botón de esta página o desde la sección de contacto, y cuéntame en pocas palabras qué te trae. Si prefieres hablar antes, empezamos con una primera llamada gratuita de 15 minutos, sin compromiso. Después acordamos juntos el día y la hora.',
  },
  {
    pregunta: '¿Cuánto duran las sesiones y con qué frecuencia?',
    respuesta:
      'Las sesiones, individuales o de pareja, duran 50 minutos y tengo amplia disponibilidad horaria. La frecuencia no es fija: la ajustamos a tu proceso y a tu ritmo.',
  },
  {
    pregunta: '¿Qué plataforma de videollamada usas y qué necesito?',
    respuesta:
      'Hacemos la sesión por Google Meet, Zoom o WhatsApp, a tu elección. Necesitas un dispositivo con cámara y micrófono, una buena conexión y un espacio tranquilo y privado donde puedas hablar con libertad. Te recomiendo usar auriculares.',
  },
  {
    pregunta: '¿Cuánto cuesta la sesión?',
    respuesta:
      'Los precios no aparecen en la web: prefiero dártelos en contacto directo, por WhatsApp, para explicarte cómo funciona y resolver tus dudas sin compromiso. El importe depende de si la sesión es individual o de pareja. Escríbeme cuando quieras y lo hablamos con calma.',
  },
  {
    pregunta: '¿Cómo se paga?',
    respuesta:
      'Puedes pagar por Bizum o transferencia bancaria. Si tienes cualquier duda, escríbeme y lo resolvemos.',
  },
  {
    pregunta: '¿Cuál es la política de cancelación?',
    respuesta:
      'Entiendo que a veces surgen imprevistos: solo te pido que me avises con 48 horas de antelación.',
  },
  {
    pregunta: '¿Es confidencial? ¿Se graban las sesiones?',
    respuesta:
      'Sí, todo lo que hablemos es confidencial. Estoy sujeto al secreto profesional y al código deontológico de la psicología, y trato tus datos conforme al RGPD. Las sesiones no se graban.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
  })),
};
---

<Base title={title} description={description} noindex image="/og-image-v3.png">
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(faqJsonLd)}
  ></script>
  <Header />

  <main class="font-v3-sans text-navy-900">
    <!-- Hero -->
    <section
      id="inicio"
      class="relative overflow-hidden bg-cream-50 px-6 pt-16 pb-20 sm:pt-24 sm:pb-28"
    >
      <div class="mx-auto max-w-3xl">
        <p class="animate-hero-in text-sm tracking-[0.2em] text-navy-900/60 uppercase">
          Juan Ignacio Riccardi · Psicólogo General Sanitario
        </p>
        <h1 class="animate-hero-in mt-5 font-v3-display text-4xl leading-tight italic sm:text-6xl">
          Ir y venir,
          <br />
          hasta encontrar calma.
        </h1>
        <p class="animate-hero-in mt-4 text-sm tracking-[0.16em] text-navy-900/70 uppercase [animation-delay:40ms]">
          Psicoterapia online · TCC y EMDR
        </p>

        <div
          class="animate-hero-in relative mt-8 h-px w-36 bg-navy-100 [animation-delay:80ms]"
          aria-hidden="true"
        >
          <span class="v3-drift absolute top-1/2 left-1/2 -mt-1 -ml-1 h-2 w-2 rounded-full bg-gold-400"></span>
        </div>

        <p class="animate-hero-in mt-8 max-w-xl text-lg text-navy-900/75 [animation-delay:120ms]">
          Terapia online en español para adolescentes, adultos y parejas. Sesiones de 50 minutos,
          con EMDR, para procesar lo que pesa y avanzar a tu propio ritmo.
        </p>
        <div class="animate-hero-in mt-8 flex flex-wrap items-center gap-5 [animation-delay:180ms]">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-navy-900 px-6 py-3 font-medium text-cream-50 transition-transform duration-150 ease-[var(--ease-out)] hover:scale-[1.02] active:scale-[0.98]"
          >
            Escríbeme y vemos si encajamos
          </a>
          <a
            href="#enfoques"
            class="text-sm text-navy-600 underline underline-offset-4 hover:text-navy-900"
          >
            ¿Qué es una sesión EMDR?
          </a>
        </div>
        <ul class="animate-hero-in mt-8 flex flex-wrap gap-x-6 gap-y-2 text-xs tracking-[0.12em] text-navy-900/60 uppercase [animation-delay:220ms]">
          {confianza.map((item) => (
            <li class="flex items-center gap-2">
              <span class="h-1 w-4 shrink-0 bg-gold-400" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
        <p class="animate-hero-in mt-6 text-xs text-navy-900/50 [animation-delay:240ms]">
          Lo que compartas se queda aquí, protegido por el secreto profesional.
        </p>
      </div>
    </section>

    <!-- Sobre mí: banda azul con la foto a la izquierda y el texto a la derecha, para que no se lea como una prolongación del hero (crema, solo texto) -->
    <section id="sobre-mi" class="bg-navy-900 px-6 py-20 text-cream-50 sm:py-24">
      <div
        data-reveal-group
        class="mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-[1fr_1.3fr] md:gap-16"
      >
        <div class="mx-auto md:mx-0">
          <img
            src={fotoCuadrada}
            alt="Juan Ignacio Riccardi, Psicólogo General Sanitario"
            width="900"
            height="900"
            class="aspect-square w-64 rounded-full border border-cream-50/20 object-cover sm:w-80"
          />
        </div>

        <div>
          <h2 class="font-v3-display text-3xl text-balance italic sm:text-4xl">Sobre mí</h2>
          <div class="mt-6 space-y-4 text-pretty text-cream-50/80">
            <p>
              Soy Juan Ignacio Riccardi, Licenciado en Psicología y Psicólogo General Sanitario.
              Ejerzo desde 2017, con adolescentes, adultos y parejas.
            </p>
            <p>
              Combino dos enfoques con base científica: la Terapia Cognitivo-Conductual (TCC) y EMDR
              (Eye Movement Desensitization and Reprocessing), cada uno según lo que el proceso
              pida.
            </p>
            <p>
              Mi trayectoria va de la consulta privada a las aulas. He acompañado a personas con
              discapacidad, he integrado equipos de orientación escolar y programas de inclusión, y
              doy clase de psicología y salud mental.
            </p>
          </div>

          <div class="relative mt-8 h-px w-36 bg-cream-50/20" aria-hidden="true">
            <span class="v3-drift absolute top-1/2 left-1/2 -mt-1 -ml-1 h-2 w-2 rounded-full bg-gold-400"></span>
          </div>
          <p class="mt-6 font-v3-display text-xl text-pretty italic sm:text-2xl">
            Todo ocurre online, en español, desde donde te resulte más cómodo.
          </p>
        </div>
      </div>
    </section>

    <!-- Formación -->
    <section id="formacion" class="bg-white px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-xl">
          <h2 class="font-v3-display text-3xl italic">De dónde vengo</h2>
          <p class="mt-3 text-navy-900/75">
            Grado y posgrado en Argentina, formación clínica en EMDR en España.
          </p>
        </div>

        <ol data-reveal-group class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {formacion.map((item) => (
            <li class="border-t border-navy-100 pt-4">
              <span class="block h-1 w-4 bg-gold-400" aria-hidden="true"></span>
              <p class="mt-3 text-xs tracking-[0.16em] text-navy-900/55 uppercase">{item.anio}</p>
              <h3 class="mt-2 font-v3-display text-xl italic">{item.titulo}</h3>
              <p class="mt-1 text-sm text-navy-900/70">{item.detalle}</p>
            </li>
          ))}
        </ol>

        <p data-reveal class="mt-10 max-w-3xl text-sm leading-relaxed text-navy-900/70">
          Colegiado nº 68849 en Argentina. En España ejerzo como Psicólogo General Sanitario por
          título homologado. La trayectoria completa está en
          <a
            href={linkedinHref}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-4 hover:text-navy-600"
          >
            LinkedIn
          </a>
          .
        </p>
      </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="bg-cream-50 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-xl">
          <h2 class="font-v3-display text-3xl italic">Cómo puedo ayudarte</h2>
          <p class="mt-3 text-navy-900/75">
            Sesiones online para adolescentes, adultos y parejas. Cada malestar tiene su propio
            ritmo. Encontramos el tuyo.
          </p>
        </div>

        <div
          data-reveal-group
          class="mt-10 divide-y divide-navy-100 border-t border-b border-navy-100"
        >
          {servicios.map((servicio) => (
            <div class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-8">
              <h3 class="font-v3-display text-xl italic sm:w-48 sm:shrink-0">{servicio.titulo}</h3>
              <p class="text-navy-900/75 sm:flex-1">{servicio.texto}</p>
            </div>
          ))}
        </div>

        <h3 id="enfoques" data-reveal class="mt-16 scroll-mt-24 font-v3-display text-2xl italic">
          ¿Bajo qué enfoque trabajo?
        </h3>

        <div
          data-reveal-group
          class="mt-10 divide-y divide-navy-100 border-t border-b border-navy-100"
        >
          {enfoques.map((enfoque) => (
            <div class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-8">
              <h4 class="font-v3-display text-xl italic sm:w-48 sm:shrink-0">{enfoque.titulo}</h4>
              <p class="text-navy-900/75 sm:flex-1">{enfoque.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sesiones y tarifas en una sola sección (de V4) -->
    <section id="como-funciona" class="bg-white px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-2xl">
          <h2 class="font-v3-display text-3xl text-balance text-navy-800 italic">Sesiones</h2>
          <p class="mt-3 text-pretty text-ink/80">
            Ofrecemos dos modalidades de sesión, individual y de pareja, con una duración de
            50&nbsp;minutos y en formato de videollamada.
          </p>
        </div>

        <div data-reveal-group class="mt-12 grid gap-12 md:grid-cols-2">
          <div class="flex flex-col">
            <h3 class="font-v3-display text-2xl text-balance text-navy-800 italic">
              ¿Es esto para ti?
            </h3>
            <ul class="mt-6 flex flex-1 flex-col justify-between gap-3">
              {paraQuienEs.map((item) => (
                <li class="flex items-start gap-3 text-ink/80">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="font-v3-display text-2xl text-balance text-navy-800 italic">
              Qué esperar de una sesión online
            </h3>
            <ol class="mt-6">
              {pasos.map((paso, i) => (
                <li class:list={['relative flex gap-4', { 'pb-8': i < pasos.length - 1 }]}>
                  {i < pasos.length - 1 && (
                    <span
                      class="absolute top-10 bottom-0 left-5 w-px bg-navy-100"
                      aria-hidden="true"
                    />
                  )}
                  <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy-800 font-v3-display text-lg text-cream-50 italic">
                    {paso.numero}
                  </span>
                  <div>
                    <h4 class="font-semibold text-navy-800">{paso.titulo}</h4>
                    <p class="mt-1 text-sm leading-relaxed text-ink/70">{paso.texto}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div
          data-reveal
          class="mt-12 overflow-hidden rounded-2xl border border-navy-100 bg-cream-50"
        >
          <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
            <h3 class="font-v3-display text-2xl text-balance text-navy-800 italic">
              Condiciones del servicio
            </h3>
            <a
              href={tarifaHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Consultar tarifa por WhatsApp"
              class={`inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-navy-800 px-3 py-2 text-base font-semibold text-cream-50 transition-transform duration-300 ${curva} hover:scale-[1.02] active:scale-[0.98] ${foco}`}
            >
              <svg
                viewBox="0 0 256 256"
                fill="currentColor"
                class="h-5 w-5 shrink-0"
                aria-hidden="true"
              >
                <path d={iconoWhatsApp} />
              </svg>
              Consultar tarifa
            </a>
          </div>

          <ul class="grid gap-px border-t border-navy-100 bg-navy-100 sm:grid-cols-2 lg:grid-cols-4">
            {condiciones.map((condicion) => (
              <li class="flex gap-4 bg-cream-50 p-6 sm:block">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy-100">
                  <svg
                    viewBox="0 0 256 256"
                    fill="currentColor"
                    class="h-6 w-6 text-navy-800"
                    aria-hidden="true"
                  >
                    <path d={iconosPh[condicion.icono]} />
                  </svg>
                </div>
                <div class="sm:mt-4">
                  <p class="text-xs tracking-[0.12em] text-ink/70 uppercase">{condicion.clave}</p>
                  <p class="mt-2 text-sm text-pretty text-ink/80">
                    {condicion.destacado ? (
                      <>
                        {condicion.valor.split(condicion.destacado)[0]}
                        <strong class="font-bold text-navy-800">{condicion.destacado}</strong>
                        {condicion.valor.split(condicion.destacado)[1]}
                      </>
                    ) : (
                      condicion.valor
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Preguntas frecuentes -->
    <section id="faq" class="bg-cream-50 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-3xl">
        <h2 data-reveal class="font-v3-display text-3xl italic">
          Preguntas frecuentes
        </h2>

        <div
          data-reveal-group
          class="mt-10 divide-y divide-navy-100 border-t border-b border-navy-100"
        >
          {faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-v3-display text-lg italic marker:hidden">
                {faq.pregunta}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4 shrink-0 text-navy-900/60 transition-transform duration-200 ease-[var(--ease-out)] group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-navy-900/70">{faq.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="bg-navy-900 px-6 py-20 text-cream-50 sm:py-24">
      <div data-reveal class="mx-auto max-w-2xl text-center">
        <h2 class="font-v3-display text-3xl italic">Hablemos</h2>
        <p class="mt-3 text-navy-200">
          Cuéntame qué te gustaría trabajar. El primer paso también puede ser pequeño, y la primera
          llamada, de 15 minutos, es gratuita y sin compromiso.
        </p>

        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-cream-50 px-6 py-3 font-medium text-navy-900 transition-transform duration-150 ease-[var(--ease-out)] hover:scale-[1.02] active:scale-[0.98]"
          >
            Empezar por WhatsApp
          </a>
          <a
            href={llamadaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-navy-200 underline underline-offset-4 hover:text-cream-50"
          >
            Pedir la llamada gratuita de 15 minutos
          </a>
          <a
            href={mailtoHref}
            class="text-sm text-navy-200 underline underline-offset-4 hover:text-cream-50"
          >
            riccardijuanpsi@gmail.com
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <WhatsAppFloat href={whatsappHref} />

  <script>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute('data-visible', '');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '-80px 0px' },
      );

      document
        .querySelectorAll('[data-reveal], [data-reveal-group]')
        .forEach((el) => io.observe(el));
    }
  </script>
</Base>
