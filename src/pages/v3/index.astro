---
import Base from '../../layouts/Base.astro';
import Header from '../../components/v3/Header.astro';
import Footer from '../../components/v3/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { withBase } from '../../lib/withBase';

const title = 'Propuesta 3 · Ir y venir, hasta encontrar calma · Clínica Conecta';
const description =
  'Juan Ignacio Riccardi, Psicólogo General Sanitario. Terapia online en español para adolescentes, adultos y parejas, con EMDR. Sesiones de 50 minutos.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const whatsappMessage = encodeURIComponent('Hola, me gustaría agendar una sesión');
const whatsappHref = `https://wa.me/34644751041?text=${whatsappMessage}`;
const mailtoHref = 'mailto:riccardi.juanpsi@gmail.com?subject=Consulta%20desde%20la%20web';
const linkedinHref = 'https://www.linkedin.com/in/juaniriccardi';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Clínica Conecta',
  description,
  url: canonical,
  image: new URL(withBase('/og-image-v3.png'), Astro.site).toString(),
  telephone: '+34644751041',
  email: 'riccardi.juanpsi@gmail.com',
  areaServed: 'Comunidad hispanohablante',
  availableLanguage: 'es',
  knowsAbout: ['EMDR', 'Ansiedad', 'Estrés', 'Duelo', 'Depresión', 'Terapia de pareja'],
  sameAs: [
    'https://wa.me/34644751041',
    'https://www.instagram.com/juanriccardi.conecta/',
    'https://www.facebook.com/profile.php?id=61577424099534',
    linkedinHref,
  ],
  founder: {
    '@type': 'Person',
    name: 'Juan Ignacio Riccardi',
    jobTitle: 'Psicólogo General Sanitario',
    url: linkedinHref,
    alumniOf: [
      { '@type': 'CollegeOrUniversity', name: 'Universidad del Salvador' },
      { '@type': 'CollegeOrUniversity', name: 'Universidad de Belgrano' },
      { '@type': 'CollegeOrUniversity', name: 'Universidad Aconcagua' },
    ],
  },
};

const servicios = [
  {
    titulo: 'Ansiedad',
    texto:
      'Cuando la mente se adelanta y el cuerpo se queda en alerta. Trabajamos para bajar ese ritmo, con herramientas concretas.',
  },
  {
    titulo: 'Estrés',
    texto:
      'Cuando las exigencias se acumulan más rápido de lo que puedes soltarlas. Buscamos un ritmo sostenible.',
  },
  {
    titulo: 'Duelo',
    texto: 'Un proceso que no se apura. Acompaño ese ir y venir entre el recuerdo y el presente.',
  },
  {
    titulo: 'Depresión',
    texto: 'Cuando faltan las ganas de moverse. Empezamos por pasos pequeños, a tu ritmo.',
  },
  {
    titulo: 'Adolescentes',
    texto:
      'Una edad de idas y vueltas. Un espacio propio, con la mirada de quien lleva años en equipos de orientación escolar.',
  },
  {
    titulo: 'Parejas',
    texto:
      'Para los dos, en la misma llamada. Revisamos qué se dice, qué se calla y qué hace falta cambiar.',
  },
];

const formacion = [
  {
    anio: '2013 a 2017',
    titulo: 'Licenciatura en Psicología',
    detalle: 'Universidad del Salvador, Argentina.',
  },
  {
    anio: '2024',
    titulo: 'Máster en Psicología General Sanitaria',
    detalle: 'Título homologado en España.',
  },
  {
    anio: 'Formación clínica',
    titulo: 'EMDR Nivel 1',
    detalle: 'Instituto Español de EMDR, Barcelona.',
  },
  {
    anio: 'Posgrado',
    titulo: 'Terapia Cognitivo Conductual',
    detalle: 'Universidad de Belgrano, Argentina.',
  },
  {
    anio: 'Posgrado',
    titulo: 'Terapia Dialéctico Conductual',
    detalle: 'Universidad Aconcagua, Argentina.',
  },
  {
    anio: 'En paralelo',
    titulo: 'Docencia',
    detalle: 'Psicología y salud mental en nivel secundario y superior.',
  },
];

const paraQuienEs = [
  'Sientes que la ansiedad o el estrés te superan casi todos los días.',
  'Atraviesas un duelo o una pérdida reciente.',
  'Notas que te falta motivación desde hace tiempo.',
  'Buscas un espacio para un hijo o una hija adolescente.',
  'Como pareja, queréis revisar cómo os habláis.',
  'Prefieres hacerlo desde casa, con privacidad.',
];

const pasos = [
  {
    numero: '1',
    titulo: 'Escríbeme',
    texto: 'Cuéntame qué te trae a terapia. Buscamos juntos el mejor horario para empezar.',
  },
  {
    numero: '2',
    titulo: 'Nos encontramos online',
    texto:
      'Una sesión de 50 minutos por Google Meet, Zoom o WhatsApp, en un espacio privado, desde donde estés.',
  },
  {
    numero: '3',
    titulo: 'Seguimos, a tu ritmo',
    texto: 'Cada sesión ajusta el paso según cómo vayas llegando. Sin prisas.',
  },
];

const tarifas = [
  {
    titulo: 'Sesión individual',
    publico: 'Adolescentes y adultos',
    duracion: '50 minutos por videollamada',
  },
  {
    titulo: 'Sesión de pareja',
    publico: 'Los dos, en la misma llamada',
    duracion: '50 minutos por videollamada',
  },
];

const condiciones = [
  { clave: 'Formas de pago', valor: 'Bizum o transferencia bancaria.' },
  { clave: 'Cancelaciones', valor: 'Con 48 horas de antelación.' },
  { clave: 'Plataformas', valor: 'Google Meet, Zoom o WhatsApp.' },
  { clave: 'Horarios', valor: 'Amplia disponibilidad, vivas en el huso horario que vivas.' },
];
---

<Base title={title} description={description} noindex image="/og-image-v3.png">
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,500;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
    slot="head"
  />

  <Header />

  <main class="font-v3-sans text-navy-900">
    <!-- Hero -->
    <section
      id="inicio"
      class="relative overflow-hidden bg-cream-50 px-6 pt-16 pb-20 sm:pt-24 sm:pb-28"
    >
      <div class="mx-auto max-w-3xl">
        <p class="animate-hero-in text-sm tracking-[0.2em] text-navy-900/60 uppercase">
          Juan Ignacio Riccardi · Psicólogo General Sanitario
        </p>
        <h1 class="animate-hero-in mt-5 font-v3-display text-4xl leading-tight italic sm:text-6xl">
          Ir y venir,
          <br />
          hasta encontrar calma.
        </h1>

        <div
          class="animate-hero-in relative mt-8 h-px w-36 bg-navy-100 [animation-delay:80ms]"
          aria-hidden="true"
        >
          <span class="v3-drift absolute top-1/2 left-1/2 -mt-1 -ml-1 h-2 w-2 rounded-full bg-gold-400"></span>
        </div>

        <p class="animate-hero-in mt-8 max-w-xl text-lg text-navy-900/75 [animation-delay:120ms]">
          Terapia online en español para adolescentes, adultos y parejas. Sesiones de 50 minutos,
          con EMDR, para procesar lo que pesa y avanzar a tu propio ritmo.
        </p>
        <div class="animate-hero-in mt-8 flex flex-wrap items-center gap-5 [animation-delay:180ms]">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-navy-900 px-6 py-3 font-medium text-cream-50 transition-transform duration-150 ease-[var(--ease-out)] hover:scale-[1.02] active:scale-[0.98]"
          >
            Escríbeme por WhatsApp
          </a>
          <a
            href="#sobre-mi"
            class="text-sm text-navy-600 underline underline-offset-4 hover:text-navy-900"
          >
            ¿Qué es una sesión EMDR?
          </a>
        </div>
      </div>
    </section>

    <!-- Sobre mí -->
    <section id="sobre-mi" class="bg-cream-50 px-6 py-20 sm:py-24">
      <div data-reveal class="mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-[1.3fr_1fr]">
        <div>
          <p class="font-v3-display text-2xl leading-snug italic sm:text-3xl">
            "Trabajo con EMDR porque a veces no basta con hablar: hay recuerdos que el cuerpo
            necesita procesar de otra forma."
          </p>
          <div class="mt-6 space-y-4 text-navy-900/75">
            <p>
              Soy Juan Ignacio Riccardi, Licenciado en Psicología y Psicólogo General Sanitario.
              Ejerzo desde 2017, con adolescentes, adultos y parejas.
            </p>
            <p>
              Combino herramientas psicológicas con base científica y EMDR (Eye Movement
              Desensitization and Reprocessing) para el trabajo con ansiedad, estrés, duelo y
              depresión.
            </p>
            <p>
              Mi trayectoria va de la consulta privada a las aulas. He acompañado a personas con
              discapacidad, he integrado equipos de orientación escolar y programas de inclusión, y
              doy clase de psicología y salud mental.
            </p>
            <p>
              Todo ocurre online, en español, para cualquier persona hispanohablante, sin importar
              dónde vivas.
            </p>
          </div>
        </div>

        <div class="mx-auto md:mx-0">
          <div class="flex aspect-square w-56 items-center justify-center rounded-full border border-navy-100 bg-white p-6 text-center text-xs text-navy-900/60 sm:w-64">
            Foto profesional de Juan Ignacio. Reemplazar por foto real.
          </div>
          <p class="mt-4 w-56 border-t border-navy-100 pt-3 text-center text-xs text-navy-900/60 sm:w-64">
            Vídeo de presentación de 60 a 90 segundos. Pendiente de grabar.
          </p>
        </div>
      </div>
    </section>

    <!-- Formación -->
    <section id="formacion" class="bg-white px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-xl">
          <h2 class="font-v3-display text-3xl italic">De dónde vengo</h2>
          <p class="mt-3 text-navy-900/75">
            Grado y posgrado en Argentina, formación clínica en EMDR en España.
          </p>
        </div>

        <ol data-reveal-group class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {formacion.map((item) => (
            <li class="border-t border-navy-100 pt-4">
              <span class="block h-1 w-4 bg-gold-400" aria-hidden="true"></span>
              <p class="mt-3 text-xs tracking-[0.16em] text-navy-900/55 uppercase">{item.anio}</p>
              <h3 class="mt-2 font-v3-display text-xl italic">{item.titulo}</h3>
              <p class="mt-1 text-sm text-navy-900/70">{item.detalle}</p>
            </li>
          ))}
        </ol>

        <p data-reveal class="mt-10 max-w-3xl text-sm leading-relaxed text-navy-900/70">
          Colegiado nº 68849 en Argentina. En España ejerzo como Psicólogo General Sanitario por
          título homologado, con la colegiación pendiente de tramitar. La trayectoria completa está
          en
          <a
            href={linkedinHref}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-4 hover:text-navy-600"
          >
            LinkedIn
          </a>
          .
        </p>
      </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="bg-cream-50 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-xl">
          <h2 class="font-v3-display text-3xl italic">Cómo puedo ayudarte</h2>
          <p class="mt-3 text-navy-900/75">
            Sesiones online para adolescentes, adultos y parejas, adaptadas a cada proceso.
          </p>
        </div>

        <div
          data-reveal-group
          class="mt-10 divide-y divide-navy-100 border-t border-b border-navy-100"
        >
          {servicios.map((servicio) => (
            <div class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-8">
              <h3 class="font-v3-display text-xl italic sm:w-48 sm:shrink-0">{servicio.titulo}</h3>
              <p class="text-navy-900/75 sm:flex-1">{servicio.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Cómo funciona / Para quién es -->
    <section id="como-funciona" class="bg-white px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <div data-reveal>
          <h2 class="font-v3-display text-3xl italic">¿Te reconoces aquí?</h2>

          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {paraQuienEs.map((item) => (
              <li class="flex items-start gap-3 text-navy-900/75">
                <span class="mt-2.5 h-1 w-4 shrink-0 bg-gold-400" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <h3 data-reveal class="mt-16 font-v3-display text-2xl italic">
          Así es el proceso
        </h3>

        <div data-reveal-group class="mt-10 space-y-8">
          {pasos.map((paso, i) => (
            <div
              class:list={[
                'flex flex-col gap-3 sm:items-center sm:gap-6',
                i % 2 === 1 ? 'sm:flex-row-reverse sm:text-right' : 'sm:flex-row',
              ]}
            >
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-900 font-v3-display text-lg text-cream-50 italic">
                {paso.numero}
              </div>
              <div
                class:list={[
                  'v3-connector hidden h-px flex-1 bg-navy-100 sm:block',
                  i % 2 === 1 ? 'origin-right' : 'origin-left',
                ]}
                aria-hidden="true"
              ></div>
              <div class="sm:max-w-sm">
                <h4 class="font-semibold">{paso.titulo}</h4>
                <p class="mt-1 text-sm text-navy-900/70">{paso.texto}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Tarifas -->
    <section id="tarifas" class="bg-cream-50 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-xl">
          <h2 class="font-v3-display text-3xl italic">Tarifas</h2>
          <p class="mt-3 text-navy-900/75">
            Todas las sesiones duran 50 minutos y se hacen por videollamada.
          </p>
        </div>

        <div data-reveal-group class="mt-10 grid gap-8 sm:grid-cols-2">
          {tarifas.map((tarifa) => (
            <div class="border-t border-navy-900/20 pt-5">
              <h3 class="font-v3-display text-2xl italic">{tarifa.titulo}</h3>
              <p class="mt-2 text-sm text-navy-900/70">{tarifa.publico}</p>
              <p class="mt-1 text-sm text-navy-900/70">{tarifa.duracion}</p>
              <p class="mt-5 inline-block border-b border-dashed border-navy-900/30 pb-1 text-sm text-navy-900/60">
                Precio pendiente de confirmar
              </p>
            </div>
          ))}
        </div>

        <dl
          data-reveal
          class="mt-12 divide-y divide-navy-100 border-t border-b border-navy-100 text-sm"
        >
          {condiciones.map((condicion) => (
            <div class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-8">
              <dt class="tracking-[0.12em] text-navy-900/55 uppercase sm:w-48 sm:shrink-0">
                {condicion.clave}
              </dt>
              <dd class="text-navy-900/75 sm:flex-1">{condicion.valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="bg-navy-900 px-6 py-20 text-cream-50 sm:py-24">
      <div data-reveal class="mx-auto max-w-2xl text-center">
        <h2 class="font-v3-display text-3xl italic">Hablemos</h2>
        <p class="mt-3 text-navy-200">
          Cuéntame qué te gustaría trabajar. El primer paso también puede ser pequeño.
        </p>

        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-cream-50 px-6 py-3 font-medium text-navy-900 transition-transform duration-150 ease-[var(--ease-out)] hover:scale-[1.02] active:scale-[0.98]"
          >
            Escríbeme por WhatsApp
          </a>
          <a
            href={mailtoHref}
            class="text-sm text-navy-200 underline underline-offset-4 hover:text-cream-50"
          >
            riccardi.juanpsi@gmail.com
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <WhatsAppFloat href={whatsappHref} />

  <script>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute('data-visible', '');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '-80px 0px' },
      );

      document
        .querySelectorAll('[data-reveal], [data-reveal-group]')
        .forEach((el) => io.observe(el));
    }
  </script>
</Base>
