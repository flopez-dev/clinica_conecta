---
import Base from '../../layouts/Base.astro';
import Header from '../../components/v2/Header.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { withBase } from '../../lib/withBase';

const title = 'Propuesta 2 · Juan Ignacio Riccardi, psicólogo online · Clínica Conecta';
const description =
  'Sesiones de psicología online en español, con un enfoque cercano y humano. Adolescentes, adultos y parejas. Ansiedad, estrés, duelo y depresión, con EMDR.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const whatsappMessage = encodeURIComponent('Hola, me gustaría agendar una sesión');
const whatsappHref = `https://wa.me/34644751041?text=${whatsappMessage}`;
const llamadaMessage = encodeURIComponent(
  'Hola, me gustaría pedir la primera llamada gratuita de 15 minutos',
);
const llamadaHref = `https://wa.me/34644751041?text=${llamadaMessage}`;
const mailtoHref = 'mailto:riccardi.juanpsi@gmail.com?subject=Consulta%20desde%20la%20web';
const linkedinHref = 'https://www.linkedin.com/in/juaniriccardi';
const instagramHref = 'https://www.instagram.com/juanriccardi.conecta/';
const facebookHref = 'https://www.facebook.com/profile.php?id=61577424099534';
const fotoCuadrada = withBase('/foto/juan-ignacio-cuadrada.webp');

// Juan es la entidad principal, no un negocio local. `ProfessionalService`
// es un subtipo de LocalBusiness, o sea de Place, y daba a entender que hay
// una sede física: no la hay, la consulta es solo online desde Argentina.
// Se modela como Person que presta un Service, con la marca colgando del
// servicio.
const persona = {
  '@type': 'Person',
  '@id': `${canonical}#juan`,
  name: 'Juan Ignacio Riccardi',
  jobTitle: 'Psicólogo General Sanitario',
  description,
  url: canonical,
  image: new URL(withBase('/og-image-v2.png'), Astro.site).toString(),
  telephone: '+34644751041',
  email: 'riccardi.juanpsi@gmail.com',
  knowsLanguage: 'es',
  knowsAbout: ['EMDR', 'Ansiedad', 'Estrés', 'Duelo', 'Depresión', 'Terapia de pareja'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad del Salvador' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad de Belgrano' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Aconcagua' },
  ],
  sameAs: [
    'https://wa.me/34644751041',
    'https://www.instagram.com/juanriccardi.conecta/',
    'https://www.facebook.com/profile.php?id=61577424099534',
    linkedinHref,
  ],
};

const servicio = {
  '@type': 'Service',
  name: 'Terapia psicológica online en español',
  serviceType: 'Psicoterapia online',
  provider: { '@id': `${canonical}#juan` },
  brand: { '@type': 'Brand', name: 'Clínica Conecta' },
  areaServed: 'España',
  audience: { '@type': 'Audience', audienceType: 'Adolescentes, adultos y parejas' },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: canonical,
    availableLanguage: 'es',
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [persona, servicio],
};

// Cada tarjeta: una frase de reconocimiento (cómo se vive) + una de método (qué hacemos).
const servicios = [
  {
    titulo: 'Ansiedad',
    texto:
      'Para cuando la mente no para y el cuerpo lo nota: el nudo en el estómago, la cabeza repasando el día a las tres de la mañana. Trabajamos herramientas concretas para bajar la intensidad.',
  },
  {
    titulo: 'Estrés',
    texto:
      'Para cuando el día a día pesa más de la cuenta y ya no queda hueco para ti. Buscamos juntos formas realistas de recuperar el equilibrio.',
  },
  {
    titulo: 'Duelo',
    texto:
      'Para cuando la vida sigue y tú todavía no. Un espacio para atravesar la pérdida a tu propio ritmo, sin exigencias.',
  },
  {
    titulo: 'Depresión',
    texto:
      'Para cuando levantarte ya es la tarea difícil del día. Empezamos por lo pequeño y entendemos juntos qué hay detrás del malestar.',
  },
  {
    titulo: 'Adolescentes',
    texto:
      'Para cuando en casa ya no se habla y hay más silencios que respuestas. Un lugar propio donde hablar sin sentirse juzgado, con la experiencia de años en orientación escolar.',
  },
  {
    titulo: 'Parejas',
    texto:
      'Para cuando hablar acaba en discusión o en silencio. Sesiones para los dos, con espacio para lo que cuesta decirse y para volver a entenderse.',
  },
];

const confianza = [
  'Psicólogo General Sanitario',
  'Ejerciendo desde 2017',
  'Formación en EMDR, Instituto Español de EMDR',
  'Primera llamada gratuita de 15 minutos',
];

// Contacto: curva con masa (skill /landing-page-design) y anillo de foco visible.
const curva = 'ease-[cubic-bezier(0.32,0.72,0,1)]';
const foco =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-400';

// Icono de sobre (Phosphor) del correo: va entre las redes y en el enlace de la tarjeta.
const iconoEmail =
  'M224 48H32a8 8 0 0 0-8 8v136a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a8 8 0 0 0-8-8m-20.57 16L128 133.15L52.57 64ZM216 192H40V74.19l82.59 75.71a8 8 0 0 0 10.82 0L216 74.19z';

// Iconos Phosphor (viewBox 256), en línea para no añadir dependencias.
const redes = [
  {
    nombre: 'WhatsApp',
    href: whatsappHref,
    d: 'm187.58 144.84l-32-16a8 8 0 0 0-8 .5l-14.69 9.8a40.55 40.55 0 0 1-16-16l9.8-14.69a8 8 0 0 0 .5-8l-16-32A8 8 0 0 0 104 64a40 40 0 0 0-40 40a88.1 88.1 0 0 0 88 88a40 40 0 0 0 40-40a8 8 0 0 0-4.42-7.16M152 176a72.08 72.08 0 0 1-72-72a24 24 0 0 1 19.29-23.54l11.48 23L101 118a8 8 0 0 0-.73 7.51a56.47 56.47 0 0 0 30.15 30.15A8 8 0 0 0 138 155l14.61-9.74l23 11.48A24 24 0 0 1 152 176M128 24a104 104 0 0 0-91.82 152.88l-11.35 34.05a16 16 0 0 0 20.24 20.24l34.05-11.35A104 104 0 1 0 128 24m0 192a87.87 87.87 0 0 1-44.06-11.81a8 8 0 0 0-6.54-.67L40 216l12.47-37.4a8 8 0 0 0-.66-6.54A88 88 0 1 1 128 216',
  },
  {
    nombre: 'Instagram',
    href: instagramHref,
    d: 'M128 80a48 48 0 1 0 48 48a48.05 48.05 0 0 0-48-48m0 80a32 32 0 1 1 32-32a32 32 0 0 1-32 32m48-136H80a56.06 56.06 0 0 0-56 56v96a56.06 56.06 0 0 0 56 56h96a56.06 56.06 0 0 0 56-56V80a56.06 56.06 0 0 0-56-56m40 152a40 40 0 0 1-40 40H80a40 40 0 0 1-40-40V80a40 40 0 0 1 40-40h96a40 40 0 0 1 40 40ZM192 76a12 12 0 1 1-12-12a12 12 0 0 1 12 12',
  },
  {
    nombre: 'Facebook',
    href: facebookHref,
    d: 'M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24m8 191.63V152h24a8 8 0 0 0 0-16h-24v-24a16 16 0 0 1 16-16h16a8 8 0 0 0 0-16h-16a32 32 0 0 0-32 32v24H96a8 8 0 0 0 0 16h24v63.63a88 88 0 1 1 16 0',
  },
  {
    nombre: 'LinkedIn',
    href: linkedinHref,
    d: 'M216 24H40a16 16 0 0 0-16 16v176a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V40a16 16 0 0 0-16-16m0 192H40V40h176zM96 112v64a8 8 0 0 1-16 0v-64a8 8 0 0 1 16 0m88 28v36a8 8 0 0 1-16 0v-36a20 20 0 0 0-40 0v36a8 8 0 0 1-16 0v-64a8 8 0 0 1 15.79-1.78A36 36 0 0 1 184 140m-84-56a12 12 0 1 1-12-12a12 12 0 0 1 12 12',
  },
  {
    nombre: 'Correo electrónico',
    href: mailtoHref,
    d: iconoEmail,
  },
];

const iconos: Record<string, string[]> = {
  Ansiedad: ['M2.5 13h3.5l2-7 3.5 13 2.5-9 1.5 3h6'],
  Estrés: ['M4 8.5c4-2.5 8-2.5 12 0', 'M4 12.5c5-3 10-3 15 0', 'M4 16.5c3.5-2 7-2 10.5 0'],
  Duelo: ['M12 3.5C8 6.5 5 10.3 5 14a7 7 0 0 0 14 0c0-3.7-3-7.5-7-10.5Z', 'M12 7v13'],
  Depresión: ['M4.5 17h15', 'M7 17a5 5 0 0 1 10 0', 'M12 8.5V6', 'M8 9.5 6.8 8', 'M16 9.5 17.2 8'],
  Adolescentes: [
    'M12 3.4a2.7 2.7 0 1 1 0 5.4 2.7 2.7 0 0 1 0-5.4Z',
    'M5.5 20.5a6.5 6.5 0 0 1 13 0',
  ],
  Parejas: [
    'M9.2 4.2a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8Z',
    'M16.4 6.4a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2Z',
    'M3.6 19.5a5.6 5.6 0 0 1 11.2 0',
    'M16.6 14a4.8 4.8 0 0 1 3.8 5.5',
  ],
};

const formacion = [
  {
    anio: '2013 a 2017',
    titulo: 'Licenciatura en Psicología',
    detalle: 'Universidad del Salvador, Argentina.',
  },
  {
    anio: '2024',
    titulo: 'Máster en Psicología General Sanitaria',
    detalle: 'Título homologado en España.',
  },
  {
    anio: 'Formación clínica',
    titulo: 'EMDR Nivel 1',
    detalle: 'Instituto Español de EMDR, Barcelona.',
  },
  {
    anio: 'Posgrado',
    titulo: 'Terapia Cognitivo Conductual y Terapia Dialéctico Conductual',
    detalle: 'Universidad de Belgrano y Universidad Aconcagua, Argentina.',
  },
  {
    anio: 'En paralelo',
    titulo: 'Docencia',
    detalle: 'Clases de psicología y salud mental en nivel secundario y superior.',
  },
];

const paraQuienEs = [
  'Sientes que la ansiedad o el estrés te superan casi todos los días.',
  'Estás atravesando un duelo o una pérdida reciente.',
  'Notas que te falta motivación o ánimo desde hace tiempo.',
  'Tienes un hijo o una hija adolescente que necesita su propio espacio.',
  'Como pareja, os cuesta hablar sin que la conversación acabe mal.',
  'Prefieres la privacidad y comodidad de hacerlo desde casa.',
];

const pasos = [
  {
    numero: '1',
    titulo: 'Escríbeme',
    texto:
      'Cuéntame, con tus palabras, qué te gustaría trabajar. Si prefieres hablar antes, empezamos con una primera llamada gratuita de 15 minutos.',
  },
  {
    numero: '2',
    titulo: 'Nos vemos online',
    texto:
      'Una videollamada de 50 minutos por Google Meet, Zoom o WhatsApp, desde donde te sientas cómodo o cómoda.',
  },
  {
    numero: '3',
    titulo: 'Seguimos a tu lado',
    texto: 'Cada sesión se ajusta a cómo vas llegando. Vamos a tu ritmo, sin prisas.',
  },
];

const tarifas = [
  {
    titulo: 'Sesión individual',
    publico: 'Para adolescentes y adultos',
    duracion: '50 minutos por videollamada',
  },
  {
    titulo: 'Sesión de pareja',
    publico: 'Para los dos, en la misma llamada',
    duracion: '50 minutos por videollamada',
  },
];

const condiciones = [
  'Puedes pagar por Bizum o por transferencia bancaria.',
  'Si necesitas cancelar, avísame con 48 horas de antelación.',
  'La llamada se hace por Google Meet, Zoom o WhatsApp, lo que te resulte más fácil.',
  'Tengo amplia disponibilidad horaria.',
];

const enfoques = [
  {
    titulo: 'TCC (Terapia Cognitivo-Conductual)',
    texto:
      'Parte de una idea sencilla: no son los hechos los que nos hacen sufrir, sino cómo los interpretamos y lo que hacemos a partir de ahí. Es un enfoque práctico y estructurado: identificamos juntos esos pensamientos que no te ayudan, como pensar "todo me va a salir mal" tras un solo contratiempo, y los sustituimos por formas de pensar más realistas. También vamos cambiando, poco a poco, los comportamientos que mantienen tu malestar, como evitar situaciones por miedo. Es especialmente eficaz para la ansiedad, la depresión y el estrés, y suele dar resultados visibles en relativamente poco tiempo.',
  },
  {
    titulo: 'EMDR',
    texto:
      'Es una terapia que ayuda a tu cerebro a "digerir" recuerdos o experiencias difíciles que se han quedado atascados y te siguen afectando en el presente, aunque haya pasado tiempo: ansiedad, pesadillas o reacciones desproporcionadas ante ciertas situaciones. Durante la sesión, mientras recuerdas brevemente esa experiencia, te guío a través de un tipo de estimulación (normalmente con movimientos oculares) que ayuda a tu cerebro a procesar ese recuerdo de una forma más sana. No se trata de olvidar lo ocurrido, sino de que deje de doler y de condicionar tu día a día.',
  },
];

const faqs = [
  {
    pregunta: '¿La terapia online es tan eficaz como la presencial?',
    respuesta:
      'Sí: la evidencia respalda que la terapia por videollamada logra resultados comparables a la presencial, como en la ansiedad, la depresión o el estrés. Solo necesitas una conexión estable y un sitio donde puedas hablar con tranquilidad.',
  },
  {
    pregunta: '¿Qué problemas trabajas y desde qué enfoque?',
    respuesta:
      'Trabajo la ansiedad, el estrés, el duelo y la depresión, y acompaño a adolescentes y a parejas. Combino la terapia cognitivo-conductual, práctica y estructurada, con EMDR para recuerdos difíciles que te siguen afectando. Ajusto las herramientas a tu proceso y a tu ritmo.',
  },
  {
    pregunta: '¿En qué casos no es recomendable la terapia online?',
    respuesta:
      'No es el recurso adecuado en una crisis o emergencia, si hay riesgo de autolesión o de hacer daño a otras personas, ni cuando hace falta atención presencial o psiquiátrica urgente. En esos casos, llama al 024 (atención a la conducta suicida) o al 112 (emergencias); si sufres violencia de género, al 016. Y si dudas de si tu caso encaja, cuéntamelo y te oriento con honestidad.',
  },
  {
    pregunta: '¿Estás colegiado y tienes habilitación sanitaria?',
    respuesta:
      'Soy Licenciado en Psicología por la Universidad del Salvador (Argentina) y Psicólogo General Sanitario en España, por título homologado en 2024. Estoy colegiado con el número 68849 en Argentina.',
  },
  {
    pregunta: '¿Cómo reservo la primera cita?',
    respuesta:
      'Escríbeme por WhatsApp desde el botón de esta página o desde la sección de contacto, y cuéntame en pocas palabras qué te trae. Si prefieres hablar antes, empezamos con una primera llamada gratuita de 15 minutos, sin compromiso. Después acordamos juntos el día y la hora.',
  },
  {
    pregunta: '¿Cuánto duran las sesiones y con qué frecuencia?',
    respuesta:
      'Las sesiones, individuales o de pareja, duran 50 minutos y tengo amplia disponibilidad horaria. La frecuencia no es fija: la ajustamos a tu proceso y a tu ritmo.',
  },
  {
    pregunta: '¿Qué plataforma de videollamada usas y qué necesito?',
    respuesta:
      'Hacemos la sesión por Google Meet, Zoom o WhatsApp, a tu elección. Necesitas un dispositivo con cámara y micrófono, una buena conexión y un espacio tranquilo y privado donde puedas hablar con libertad. Te recomiendo usar auriculares.',
  },
  {
    pregunta: '¿Cuánto cuesta la sesión?',
    respuesta:
      'Los precios no aparecen en la web: prefiero dártelos en contacto directo, por WhatsApp, para explicarte cómo funciona y resolver tus dudas sin compromiso. El importe depende de si la sesión es individual o de pareja. Escríbeme cuando quieras y lo hablamos con calma.',
  },
  {
    pregunta: '¿Cómo se paga?',
    respuesta:
      'Puedes pagar por Bizum o transferencia bancaria. Si tienes cualquier duda, escríbeme y lo resolvemos.',
  },
  {
    pregunta: '¿Cuál es la política de cancelación?',
    respuesta:
      'Entiendo que a veces surgen imprevistos: solo te pido que me avises con 48 horas de antelación.',
  },
  {
    pregunta: '¿Es confidencial? ¿Se graban las sesiones?',
    respuesta:
      'Sí, todo lo que hablemos es confidencial. Estoy sujeto al secreto profesional y al código deontológico de la psicología, y trato tus datos conforme al RGPD. Las sesiones no se graban.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
  })),
};
---

<Base title={title} description={description} noindex image="/og-image-v2.png">
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(faqJsonLd)}
  ></script>
  <Header />

  <main class="font-v2-sans text-ink">
    <!-- Hero -->
    <section
      id="inicio"
      class="relative overflow-hidden bg-cream-50 px-6 pb-20 pt-14 sm:pb-28 sm:pt-20"
    >
      <div
        class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-navy-100/70 blur-2xl"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-2">
        <div>
          <p class="animate-hero-in text-sm tracking-[0.2em] text-navy-600 uppercase">
            Juan Ignacio Riccardi · Psicólogo General Sanitario
          </p>
          <h1 class="animate-hero-in mt-4 font-v2-serif text-4xl leading-tight text-navy-800 sm:text-5xl">
            Psicólogo online para lo que llevas tiempo callando
          </h1>
          <p class="animate-hero-in mt-5 max-w-lg text-lg text-ink/75 [animation-delay:80ms]">
            Sesiones online para adolescentes, adultos y parejas. Cincuenta minutos por videollamada
            para acompañarte con ansiedad, estrés, duelo o depresión, con herramientas con aval
            científico, entre ellas EMDR.
          </p>
          <div class="animate-hero-in mt-8 flex flex-wrap items-center gap-4 [animation-delay:160ms]">
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-full bg-navy-800 px-6 py-3 font-medium text-cream-50 transition-transform duration-150 ease-[var(--ease-out)] hover:scale-[1.02] active:scale-[0.98]"
            >
              Escríbeme y vemos si encajamos
            </a>
            <a
              href="#como-funciona"
              class="text-sm text-navy-800 underline decoration-gold-400 underline-offset-4 hover:text-navy-600"
            >
              ¿Cómo es una primera sesión?
            </a>
          </div>
          <ul class="animate-hero-in mt-8 flex flex-wrap gap-x-5 gap-y-2 text-xs text-navy-800/70 [animation-delay:200ms]">
            {confianza.map((item) => (
              <li class="flex items-center gap-2">
                <span
                  class="h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"
                  aria-hidden="true"
                ></span>
                {item}
              </li>
            ))}
          </ul>
          <p class="animate-hero-in mt-6 text-xs text-ink/50 [animation-delay:220ms]">
            Todo lo que me cuentes queda entre nosotros, protegido por el secreto profesional.
          </p>
        </div>

        <div class="animate-hero-in [animation-delay:120ms]">
          <img
            src={fotoCuadrada}
            alt="Juan Ignacio Riccardi, Psicólogo General Sanitario"
            width="900"
            height="900"
            class="v2-blob-1 mx-auto aspect-square max-w-sm border border-navy-100 object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Sobre mí -->
    <section id="sobre-mi" class="bg-white px-6 py-20 sm:py-24">
      <div
        data-reveal
        class="mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]"
      >
        <div class="rounded-3xl border border-navy-100 bg-cream-50 p-8 shadow-[0_16px_40px_-28px_rgba(42,63,106,0.35)] sm:p-10">
          <span class="block h-px w-12 bg-gold-400" aria-hidden="true"></span>
          <p class="mt-6 font-v2-serif text-2xl leading-snug text-navy-800 italic sm:text-3xl">
            "Creo en la terapia como un espacio para sentirte acompañado, no juzgado."
          </p>
        </div>
        <div>
          <h2 class="font-v2-serif text-3xl text-navy-800">Sobre mí</h2>
          <div class="mt-6 space-y-4 text-ink/75">
            <p>
              Soy Juan Ignacio Riccardi, Licenciado en Psicología y Psicólogo General Sanitario.
              Ejerzo desde 2017 y acompaño a adolescentes, adultos y parejas que atraviesan
              ansiedad, estrés, duelo o depresión.
            </p>
            <p>
              Combino dos enfoques con base científica: la Terapia Cognitivo-Conductual (TCC), para
              trabajar los pensamientos y comportamientos que mantienen el malestar, y EMDR, para
              procesar los recuerdos difíciles. Me adapto a lo que cada proceso necesita.
            </p>
            <p>
              Mi trabajo se reparte entre la consulta privada y la educación. He acompañado a
              personas con discapacidad, he formado parte de equipos de orientación escolar y doy
              clase de psicología y salud mental.
            </p>
            <p>
              Todo ocurre online, en un espacio privado y cercano, desde donde te resulte más
              cómodo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Formación -->
    <section id="formacion" class="bg-cream-50 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-xl">
          <h2 class="font-v2-serif text-3xl text-navy-800">Mi formación</h2>
          <p class="mt-3 text-ink/75">
            Grado y posgrado en Argentina, formación clínica en EMDR en España y una práctica que
            sigue en marcha.
          </p>
        </div>

        <ol data-reveal-group class="mt-12 space-y-4">
          {formacion.map((item) => (
            <li class="flex flex-col gap-2 rounded-3xl border border-navy-100 bg-white p-6 shadow-[0_16px_40px_-28px_rgba(42,63,106,0.35)] sm:flex-row sm:items-baseline sm:gap-8">
              <span class="text-sm tracking-[0.12em] text-navy-600 uppercase sm:w-44 sm:shrink-0">
                {item.anio}
              </span>
              <div>
