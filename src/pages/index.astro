---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { withBase } from '../lib/withBase';

const title = 'Juan Ignacio Riccardi · Psicólogo online en español · Clínica Conecta';
const description =
  'Psicólogo General Sanitario. Terapia online en español para adolescentes, adultos y parejas. Ansiedad, estrés, duelo y depresión, con EMDR. Sesiones de 50 minutos.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const whatsappMessage = encodeURIComponent('Hola, me gustaría agendar una sesión');
const whatsappHref = `https://wa.me/34644751041?text=${whatsappMessage}`;
const llamadaMessage = encodeURIComponent(
  'Hola, me gustaría pedir la primera llamada gratuita de 15 minutos',
);
const llamadaHref = `https://wa.me/34644751041?text=${llamadaMessage}`;
const mailtoHref = 'mailto:riccardi.juanpsi@gmail.com?subject=Consulta%20desde%20la%20web';
const linkedinHref = 'https://www.linkedin.com/in/juaniriccardi';
const fotoVertical = withBase('/foto/juan-ignacio-vertical.webp');

// Juan es la entidad principal, no un negocio local. `ProfessionalService`
// es un subtipo de LocalBusiness, o sea de Place, y daba a entender que hay
// una sede física: no la hay, la consulta es solo online desde Argentina.
// Se modela como Person que presta un Service, con la marca colgando del
// servicio.
const persona = {
  '@type': 'Person',
  '@id': `${canonical}#juan`,
  name: 'Juan Ignacio Riccardi',
  jobTitle: 'Psicólogo General Sanitario',
  description,
  url: canonical,
  image: new URL(withBase('/og-image.png'), Astro.site).toString(),
  telephone: '+34644751041',
  email: 'riccardi.juanpsi@gmail.com',
  knowsLanguage: 'es',
  knowsAbout: ['EMDR', 'Ansiedad', 'Estrés', 'Duelo', 'Depresión', 'Terapia de pareja'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad del Salvador' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad de Belgrano' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Aconcagua' },
  ],
  sameAs: [
    'https://wa.me/34644751041',
    'https://www.instagram.com/juanriccardi.conecta/',
    'https://www.facebook.com/profile.php?id=61577424099534',
    linkedinHref,
  ],
};

const servicio = {
  '@type': 'Service',
  name: 'Terapia psicológica online en español',
  serviceType: 'Psicoterapia online',
  provider: { '@id': `${canonical}#juan` },
  brand: { '@type': 'Brand', name: 'Clínica Conecta' },
  areaServed: 'España',
  audience: { '@type': 'Audience', audienceType: 'Adolescentes, adultos y parejas' },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: canonical,
    availableLanguage: 'es',
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [persona, servicio],
};

// Cada tarjeta: una frase de reconocimiento (cómo se vive) + una de método (qué hacemos).
const servicios = [
  {
    titulo: 'Ansiedad',
    texto:
      'Para dejar de repasar el día entero a las tres de la mañana. Trabajamos la preocupación que no para y lo que el cuerpo hace con ella.',
  },
  {
    titulo: 'Estrés',
    texto:
      'Cuando el día a día te desborda y no encuentras el botón de pausa. Vemos qué lo alimenta y practicamos recursos concretos para recuperar el equilibrio.',
  },
  {
    titulo: 'Duelo',
    texto:
      'Cuando la vida sigue y tú todavía no. Te acompaño a tu ritmo, con espacio para todo lo que sientas.',
  },
  {
    titulo: 'Depresión',
    texto:
      'Cuando levantarse ya es la tarea difícil del día. Empezamos por lo pequeño y recuperamos margen desde ahí.',
  },
  {
    titulo: 'Adolescentes',
    texto:
      'Cuando en casa ya no se habla y hay más silencios que respuestas. Un espacio propio para el adolescente, con la experiencia de años en equipos de orientación escolar.',
  },
  {
    titulo: 'Terapia de pareja',
    texto:
      'Cuando hablar se ha convertido en discutir, o en no decir nada. Sesiones conjuntas para revisar cómo os comunicáis y lo que cada uno necesita.',
  },
];

const confianza = [
  'Psicólogo General Sanitario',
  'Ejerciendo desde 2017',
  'Formación en EMDR, Instituto Español de EMDR',
  'Primera llamada gratuita de 15 minutos',
];

const formacion = [
  {
    titulo: 'Licenciatura en Psicología',
    detalle: 'Universidad del Salvador, Argentina. 2013 a 2017.',
  },
  {
    titulo: 'Máster en Psicología General Sanitaria',
    detalle: 'Título homologado en España en 2024.',
  },
  {
    titulo: 'EMDR Nivel 1',
    detalle: 'Instituto Español de EMDR, Barcelona.',
  },
  {
    titulo: 'Terapia Cognitivo Conductual',
    detalle: 'Universidad de Belgrano, Argentina.',
  },
  {
    titulo: 'Terapia Dialéctico Conductual',
    detalle: 'Universidad Aconcagua, Argentina.',
  },
  {
    titulo: 'Docencia',
    detalle: 'Nivel secundario y superior, en materias de psicología y salud mental.',
  },
];

const paraQuienEs = [
  'Sientes ansiedad o estrés que no consigues gestionar por tu cuenta.',
  'Atraviesas un duelo o una pérdida reciente.',
  'Notas síntomas de depresión o desmotivación persistente.',
  'Eres madre, padre o tutor y buscas apoyo para un adolescente.',
  'Como pareja, queréis recuperar una forma de hablar que se ha roto.',
  'Prefieres la comodidad y la privacidad de la terapia online.',
];

const pasos = [
  {
    numero: '1',
    titulo: 'Escríbeme',
    texto:
      'Cuéntame por WhatsApp, en pocas palabras, qué te trae a terapia. Si prefieres hablar antes, empezamos con una primera llamada gratuita de 15 minutos.',
  },
  {
    numero: '2',
    titulo: 'Sesión online',
    texto:
      'Videollamada de 50 minutos, en un espacio privado y confidencial, por Google Meet, Zoom o WhatsApp.',
  },
  {
    numero: '3',
    titulo: 'Seguimiento',
    texto:
      'Avanzamos sesión a sesión, ajustando el enfoque y las herramientas a tu proceso y tu ritmo.',
  },
];

const tarifas = [
  {
    titulo: 'Sesión individual',
    publico: 'Adolescentes y adultos',
    duracion: '50 minutos por videollamada',
  },
  {
    titulo: 'Sesión de pareja',
    publico: 'Sesión conjunta para los dos',
    duracion: '50 minutos por videollamada',
  },
];

const condiciones = [
  'Pago por Bizum o transferencia bancaria.',
  'Las cancelaciones se avisan con 48 horas de antelación.',
  'La videollamada se hace por Google Meet, Zoom o WhatsApp, lo que te resulte más cómodo.',
  'Amplia disponibilidad horaria.',
];

const enfoques = [
  {
    titulo: 'TCC (Terapia Cognitivo-Conductual)',
    texto:
      'Parte de una idea sencilla: no son los hechos los que nos hacen sufrir, sino cómo los interpretamos y lo que hacemos a partir de ahí. Es un enfoque práctico y estructurado: identificamos juntos esos pensamientos que no te ayudan, como pensar "todo me va a salir mal" tras un solo contratiempo, y los sustituimos por formas de pensar más realistas. También vamos cambiando, poco a poco, los comportamientos que mantienen tu malestar, como evitar situaciones por miedo. Es especialmente eficaz para la ansiedad, la depresión y el estrés, y suele dar resultados visibles en relativamente poco tiempo.',
  },
  {
    titulo: 'EMDR',
    texto:
      'Es una terapia que ayuda a tu cerebro a "digerir" recuerdos o experiencias difíciles que se han quedado atascados y te siguen afectando en el presente, aunque haya pasado tiempo: ansiedad, pesadillas o reacciones desproporcionadas ante ciertas situaciones. Durante la sesión, mientras recuerdas brevemente esa experiencia, te guío a través de un tipo de estimulación (normalmente con movimientos oculares) que ayuda a tu cerebro a procesar ese recuerdo de una forma más sana. No se trata de olvidar lo ocurrido, sino de que deje de doler y de condicionar tu día a día.',
  },
];

const faqs = [
  {
    pregunta: '¿Cómo son las sesiones?',
    respuesta:
      'Sesiones individuales o de pareja de 50 minutos, por videollamada en Google Meet, Zoom o WhatsApp, en un espacio privado y confidencial.',
  },
  {
    pregunta: '¿Cuánto cuesta una sesión?',
    respuesta:
      'El precio depende de si la sesión es individual o de pareja. Te lo paso por WhatsApp antes de reservar.',
  },
  {
    pregunta: '¿La terapia online funciona igual que la presencial?',
    respuesta:
      'Sí. La investigación disponible muestra que la terapia por videollamada logra resultados comparables a la presencial en la mayoría de los casos, como la ansiedad, la depresión o el estrés. Solo necesitas una conexión estable y un sitio donde puedas hablar con tranquilidad.',
  },
  {
    pregunta: '¿Cómo sé si encajo contigo?',
    respuesta:
      'En una primera llamada de 15 minutos, gratuita y sin compromiso. Me cuentas qué te trae y te digo con honestidad si puedo ayudarte o si te conviene otro profesional.',
  },
  {
    pregunta: '¿Y si no sé por dónde empezar?',
    respuesta:
      'Es de lo más habitual. No hace falta que llegues con todo claro ni bien explicado: de eso hablamos en la primera sesión.',
  },
  {
    pregunta: '¿Qué pasa si tengo que cancelar una sesión?',
    respuesta: 'Avísame con 48 horas de antelación.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
  })),
};
---

<Base title={title} description={description}>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(faqJsonLd)}
  ></script>
  <Header />

  <main class="text-ink">
    <!-- Hero -->
    <section id="inicio" class="bg-navy-800 px-6 py-24 text-center text-cream-50 sm:py-28">
      <div class="mx-auto max-w-3xl">
        <p class="animate-hero-in font-serif text-sm tracking-[0.2em] text-gold-400 uppercase">
          Juan Ignacio Riccardi · Psicólogo General Sanitario
        </p>
        <h1 class="animate-hero-in mt-4 font-serif text-4xl font-semibold tracking-tight sm:text-5xl">
          Psicólogo online para la ansiedad, el estrés y el duelo
        </h1>
        <p class="animate-hero-in mx-auto mt-5 max-w-xl text-lg text-cream-50/85 [animation-delay:80ms]">
          Acompaño a adolescentes, adultos y parejas en procesos de ansiedad, estrés, duelo y
          depresión. Sesiones de 50 minutos por videollamada, con herramientas con aval científico,
          entre ellas EMDR.
        </p>
        <div class="animate-hero-in mt-8 flex flex-col items-center gap-3 [animation-delay:160ms] sm:flex-row sm:justify-center">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-md bg-cream-50 px-6 py-3 font-medium text-navy-800 transition-transform duration-150 ease-[var(--ease-out)] hover:scale-[1.02] active:scale-[0.98]"
          >
            Escríbeme y vemos si encajamos
          </a>
          <a
            href="#como-funciona"
            class="text-sm text-cream-50/80 underline decoration-gold-400 underline-offset-4 hover:text-cream-50"
          >
            ¿Cómo funciona una sesión online?
          </a>
        </div>
        <ul class="animate-hero-in mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-cream-50/70 [animation-delay:200ms]">
          {confianza.map((item) => (
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
        <p class="animate-hero-in mt-6 text-xs text-cream-50/60 [animation-delay:220ms]">
          Todo lo que compartas queda protegido por el secreto profesional.
        </p>
      </div>
    </section>

    <!-- Sobre mí -->
    <section id="sobre-mi" class="px-6 py-16 sm:py-20">
      <div data-reveal class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-2">
        <img
          src={fotoVertical}
          alt="Juan Ignacio Riccardi, Psicólogo General Sanitario"
          width="900"
          height="1125"
          class="aspect-[4/5] w-full rounded-lg border border-navy-100 object-cover"
        />
        <div>
          <h2 class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">Sobre mí</h2>
          <p class="mt-4 leading-relaxed text-ink/80">
            Soy Juan Ignacio Riccardi, Licenciado en Psicología y Psicólogo General Sanitario.
            Ejerzo desde 2017 y acompaño a adolescentes, adultos y parejas en procesos de ansiedad,
            estrés, duelo y depresión.
          </p>
          <p class="mt-4 leading-relaxed text-ink/80">
            Combino dos enfoques con base científica: la Terapia Cognitivo-Conductual (TCC), para
            trabajar los pensamientos y comportamientos que mantienen el malestar, y EMDR, para
            procesar traumas y experiencias difíciles.
          </p>
          <p class="mt-4 leading-relaxed text-ink/80">
            Mi trayectoria une la clínica y la educación. Llevo consulta privada, he acompañado a
            personas con discapacidad a través de obras sociales, he formado parte de equipos de
            orientación escolar y programas de inclusión, y doy clase en nivel secundario y superior
            en materias de psicología y salud mental.
          </p>
          <p class="mt-4 leading-relaxed text-ink/80">
            Todo el proceso ocurre online, en un espacio cercano, confidencial y sin juicios, desde
            donde te resulte más cómodo.
          </p>
        </div>
      </div>
    </section>

    <!-- Formación y credenciales -->
    <section id="formacion" class="bg-cream-50 px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-2xl">
          <h2 class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">
            Formación y credenciales
          </h2>
          <p class="mt-3 text-ink/80">
            Formación de grado y posgrado en Argentina, y formación clínica en EMDR en España.
          </p>
        </div>

        <dl data-reveal-group class="mt-10 grid gap-6 sm:grid-cols-2">
          {formacion.map((item) => (
            <div class="rounded-lg border border-navy-100 bg-white p-6">
              <dt class="font-serif text-lg font-semibold text-navy-800">{item.titulo}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-ink/70">{item.detalle}</dd>
            </div>
          ))}
        </dl>

        <p data-reveal class="mt-8 max-w-3xl text-sm leading-relaxed text-ink/70">
          Colegiado nº 68849 en Argentina. En España ejerzo como Psicólogo General Sanitario por
          título homologado. Puedes consultar mi trayectoria completa en
          <a
            href={linkedinHref}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-gold-400 underline-offset-4 hover:text-navy-600"
          >
            LinkedIn
          </a>
          .
        </p>
      </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-2xl">
          <h2 class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">Servicios</h2>
          <p class="mt-3 text-ink/80">
            Sesiones online para adolescentes, adultos y parejas. Sea cual sea tu proceso,
            trabajamos con herramientas con base científica, como la TCC y el EMDR.
          </p>
        </div>

        <div data-reveal-group class="mt-10 grid gap-6 sm:grid-cols-2">
          {servicios.map((servicio) => (
            <div class="rounded-lg border border-navy-100 bg-white p-6">
              <h3 class="font-serif text-lg font-semibold text-navy-800">{servicio.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{servicio.texto}</p>
            </div>
          ))}
        </div>

        <h3 data-reveal class="mt-14 font-serif text-xl font-semibold text-navy-800">
          ¿Bajo qué enfoque trabajo?
        </h3>

        <div data-reveal-group class="mt-6 grid gap-6 sm:grid-cols-2">
          {enfoques.map((enfoque) => (
            <div class="rounded-lg border border-navy-100 bg-white p-6">
              <h4 class="font-serif text-lg font-semibold text-navy-800">{enfoque.titulo}</h4>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{enfoque.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Cómo funciona / Para quién es -->
    <section id="como-funciona" class="bg-cream-50 px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div data-reveal>
          <h2 class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">
            ¿Es esto para ti?
          </h2>

          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {paraQuienEs.map((item) => (
              <li class="flex items-start gap-3 text-ink/80">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <h3 data-reveal class="mt-14 font-serif text-xl font-semibold text-navy-800">
          Qué esperar de una sesión online
        </h3>

        <div data-reveal-group class="mt-6 grid gap-8 sm:grid-cols-3">
          {pasos.map((paso) => (
            <div>
              <span class="font-serif text-3xl font-semibold text-navy-600">{paso.numero}</span>
              <h4 class="mt-2 font-medium text-navy-800">{paso.titulo}</h4>
              <p class="mt-1 text-sm leading-relaxed text-ink/70">{paso.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Tarifas -->
    <section id="tarifas" class="px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-2xl">
          <h2 class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">Tarifas</h2>
          <p class="mt-3 text-ink/80">
            Hay tarifa para sesión individual y para sesión de pareja. Todas duran 50 minutos y se
            hacen por videollamada. Te paso el precio por WhatsApp antes de reservar.
          </p>
        </div>

        <div data-reveal-group class="mt-10 grid gap-6 sm:grid-cols-2">
          {tarifas.map((tarifa) => (
            <div class="rounded-lg border border-navy-100 bg-white p-6">
              <h3 class="font-serif text-lg font-semibold text-navy-800">{tarifa.titulo}</h3>
              <p class="mt-2 text-sm text-ink/70">{tarifa.publico}</p>
              <p class="mt-1 text-sm text-ink/70">{tarifa.duracion}</p>
            </div>
          ))}
        </div>

        <ul data-reveal class="mt-8 grid max-w-3xl gap-3">
          {condiciones.map((condicion) => (
            <li class="flex items-start gap-3 text-sm text-ink/80">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>
              <span>{condicion}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Preguntas frecuentes -->
    <section id="faq" class="bg-cream-50 px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 data-reveal class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">
          Preguntas frecuentes
        </h2>

        <div data-reveal-group class="mt-8 space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-lg border border-navy-100 bg-white p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif font-semibold text-navy-800 marker:hidden">
                {faq.pregunta}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4 shrink-0 text-navy-600 transition-transform duration-200 ease-[var(--ease-out)] group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink/75">{faq.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="bg-navy-800 px-6 py-16 text-cream-50 sm:py-20">
      <div data-reveal class="mx-auto max-w-2xl text-center">
        <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Contacto</h2>
        <p class="mt-3 text-cream-50/85">
          Escríbeme y buscamos el hueco que mejor te encaje. La primera llamada, de 15 minutos, es
          gratuita y sin compromiso.
        </p>

        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-md bg-cream-50 px-6 py-3 font-medium text-navy-800 transition-transform duration-150 ease-[var(--ease-out)] hover:scale-[1.02] active:scale-[0.98]"
          >
            Empezar por WhatsApp
          </a>
          <a
            href={llamadaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-cream-50/80 underline decoration-gold-400 underline-offset-4 hover:text-cream-50"
          >
            Pedir la llamada gratuita de 15 minutos
          </a>
          <a
            href={mailtoHref}
            class="text-sm text-cream-50/80 underline decoration-gold-400 underline-offset-4 hover:text-cream-50"
          >
            riccardi.juanpsi@gmail.com
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <WhatsAppFloat href={whatsappHref} />

  <script>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute('data-visible', '');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '-80px 0px' },
      );

      document
        .querySelectorAll('[data-reveal], [data-reveal-group]')
        .forEach((el) => io.observe(el));
    }
  </script>
</Base>
