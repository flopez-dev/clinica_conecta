---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Clínica Conecta"
  description="Web de Clínica Conecta: atención cercana y citas sencillas."
>
  <Header />

  <main>
    <section class="mx-auto max-w-5xl px-6 py-24 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Clínica Conecta
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
        Contenido en construcción — esta es la base sobre la que se irá montando
        el sitio del cliente.
      </p>
    </section>

    <section id="servicios" class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-semibold text-slate-900">Servicios</h2>
      <p class="mt-2 text-slate-600">Próximamente.</p>
    </section>

    <section id="contacto" class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-semibold text-slate-900">Contacto</h2>
      <p class="mt-2 text-slate-600">Próximamente.</p>
    </section>
  </main>

  <Footer />
</Base>
