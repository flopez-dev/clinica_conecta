// que cada línea de más cuenta (Docencia admite hasta 4 líneas a 1280 px).
const formacionGrupos: {
  icono: string;
  titulo: string;
  items: { titulo: string; detalle?: string }[];
}[] = [
  {
    icono: 'graduationCap',
