---
import Base from '../../layouts/Base.astro';
import Header from '../../components/v4/Header.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import Contacto from '../../components/v4/Contacto.astro';
import Revelar from '../../components/v4/Revelar.astro';
import { withBase } from '../../lib/withBase';
import {
  facebookHref,
  iconoWhatsApp,
  instagramHref,
  linkedinHref,
  llamadaHref,
  tarifaHref,
  whatsappHref,
} from '../../lib/contacto';
import { curva, foco } from '../../lib/estilo';

const title = 'Propuesta 4 · Juan Ignacio Riccardi, psicólogo online · Clínica Conecta';
const description =
  'Psicólogo General Sanitario. Terapia online en español para adolescentes, adultos y parejas. Ansiedad, estrés, duelo y depresión, con EMDR. Sesiones de 50 minutos.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const fotoCuadrada = withBase('/foto/juan-ignacio-cuadrada-2.webp');

// Juan es la entidad principal, no un negocio local. `ProfessionalService`
// es un subtipo de LocalBusiness, o sea de Place, y daba a entender que hay
// una sede física: no la hay, la consulta es solo online desde Argentina.
// Se modela como Person que presta un Service, con la marca colgando del
// servicio.
const persona = {
  '@type': 'Person',
  '@id': `${canonical}#juan`,
  name: 'Juan Ignacio Riccardi',
  jobTitle: 'Psicólogo General Sanitario',
  description,
  url: canonical,
  image: new URL(withBase('/og-image.png'), Astro.site).toString(),
  telephone: '+34644751041',
  email: 'riccardijuanpsi@gmail.com',
  knowsLanguage: 'es',
  knowsAbout: ['EMDR', 'Ansiedad', 'Estrés', 'Duelo', 'Depresión', 'Terapia de pareja'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad del Salvador' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad de Belgrano' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Aconcagua' },
  ],
  sameAs: ['https://wa.me/34644751041', instagramHref, facebookHref, linkedinHref],
};

const servicio = {
  '@type': 'Service',
  name: 'Terapia psicológica online en español',
  serviceType: 'Psicoterapia online',
  provider: { '@id': `${canonical}#juan` },
  brand: { '@type': 'Brand', name: 'Clínica Conecta' },
  areaServed: 'España',
  audience: { '@type': 'Audience', audienceType: 'Adolescentes, adultos y parejas' },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: canonical,
    availableLanguage: 'es',
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [persona, servicio],
};

// Servicios: contenido e iconos de V2. Cada tarjeta: una frase de reconocimiento
// (cómo se vive) + una de método (qué hacemos).
const servicios = [
  {
    titulo: 'Ansiedad',
    texto:
      'Para cuando la mente no para y el cuerpo lo nota: el nudo en el estómago, la cabeza repasando el día a las tres de la mañana. Trabajamos herramientas concretas para bajar la intensidad.',
  },
  {
    titulo: 'Estrés',
    texto:
      'Para cuando el día a día pesa más de la cuenta y ya no queda hueco para ti. Buscamos juntos formas realistas de recuperar el equilibrio.',
  },
  {
    titulo: 'Duelo',
    texto:
      'Para cuando la vida sigue y tú todavía no. Un espacio para atravesar la pérdida a tu propio ritmo, sin exigencias.',
  },
  {
    titulo: 'Depresión',
    texto:
      'Para cuando levantarte ya es la tarea difícil del día. Empezamos por lo pequeño y entendemos juntos qué hay detrás del malestar.',
  },
  {
    titulo: 'Adolescentes',
    texto:
      'Para cuando en casa ya no se habla y hay más silencios que respuestas. Un lugar propio donde hablar sin sentirse juzgado, con la experiencia de años en orientación escolar.',
  },
  {
    titulo: 'Parejas',
    texto:
      'Para cuando hablar acaba en discusión o en silencio. Sesiones para los dos, con espacio para lo que cuesta decirse y para volver a entenderse.',
  },
];

// Franja de confianza bajo el hero. La llamada gratuita no va aquí: ya es el
// botón principal del hero, justo encima.
const confianza = [
  'Psicólogo General Sanitario',
  'Ejerciendo desde 2017',
  'Formación en EMDR, Instituto Español de EMDR',
];

const iconos: Record<string, string[]> = {
  Ansiedad: ['M2.5 13h3.5l2-7 3.5 13 2.5-9 1.5 3h6'],
  Estrés: ['M4 8.5c4-2.5 8-2.5 12 0', 'M4 12.5c5-3 10-3 15 0', 'M4 16.5c3.5-2 7-2 10.5 0'],
  Duelo: ['M12 3.5C8 6.5 5 10.3 5 14a7 7 0 0 0 14 0c0-3.7-3-7.5-7-10.5Z', 'M12 7v13'],
  Depresión: ['M4.5 17h15', 'M7 17a5 5 0 0 1 10 0', 'M12 8.5V6', 'M8 9.5 6.8 8', 'M16 9.5 17.2 8'],
  Adolescentes: [
    'M12 3.4a2.7 2.7 0 1 1 0 5.4 2.7 2.7 0 0 1 0-5.4Z',
    'M5.5 20.5a6.5 6.5 0 0 1 13 0',
  ],
  Parejas: [
    'M9.2 4.2a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8Z',
    'M16.4 6.4a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2Z',
    'M3.6 19.5a5.6 5.6 0 0 1 11.2 0',
    'M16.6 14a4.8 4.8 0 0 1 3.8 5.5',
  ],
};

// Iconos Phosphor (viewBox 256) de Sobre mí, Tarifas y Formación, en línea como
// `redes` para no añadir dependencias.
const iconosPh: Record<string, string> = {
  graduationCap:
    'm251.76 88.94l-120-64a8 8 0 0 0-7.52 0l-120 64a8 8 0 0 0 0 14.12L32 117.87v48.42a15.9 15.9 0 0 0 4.06 10.65C49.16 191.53 78.51 216 128 216a130 130 0 0 0 48-8.76V240a8 8 0 0 0 16 0v-40.49a115.6 115.6 0 0 0 27.94-22.57a15.9 15.9 0 0 0 4.06-10.65v-48.42l27.76-14.81a8 8 0 0 0 0-14.12M128 200c-43.27 0-68.72-21.14-80-33.71V126.4l76.24 40.66a8 8 0 0 0 7.52 0L176 143.47v46.34c-12.6 5.88-28.48 10.19-48 10.19m80-33.75a97.8 97.8 0 0 1-16 14.25v-45.57l16-8.53Zm-20-47.31l-.22-.13l-56-29.87a8 8 0 0 0-7.52 14.12L171 128l-43 22.93L25 96l103-54.93L231 96Z',
  certificate:
    'M128 136a8 8 0 0 1-8 8H72a8 8 0 0 1 0-16h48a8 8 0 0 1 8 8m-8-40H72a8 8 0 0 0 0 16h48a8 8 0 0 0 0-16m112 65.47V224a8 8 0 0 1-12 7l-24-13.74L172 231a8 8 0 0 1-12-7v-24H40a16 16 0 0 1-16-16V56a16 16 0 0 1 16-16h176a16 16 0 0 1 16 16v30.53a51.88 51.88 0 0 1 0 74.94M160 184v-22.53A52 52 0 0 1 216 76V56H40v128Zm56-12a51.88 51.88 0 0 1-40 0v38.22l16-9.16a8 8 0 0 1 7.94 0l16 9.16Zm16-48a36 36 0 1 0-36 36a36 36 0 0 0 36-36',
  chalkboardTeacher:
    'M216 40H40a16 16 0 0 0-16 16v144a16 16 0 0 0 16 16h13.39a8 8 0 0 0 7.23-4.57a48 48 0 0 1 86.76 0a8 8 0 0 0 7.23 4.57H216a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16M80 144a24 24 0 1 1 24 24a24 24 0 0 1-24-24m136 56h-56.57a64.4 64.4 0 0 0-28.83-26.16a40 40 0 1 0-53.2 0A64.4 64.4 0 0 0 48.57 200H40V56h176ZM56 96V80a8 8 0 0 1 8-8h128a8 8 0 0 1 8 8v96a8 8 0 0 1-8 8h-16a8 8 0 0 1 0-16h8V88H72v8a8 8 0 0 1-16 0',
  creditCard:
    'M224 48H32a16 16 0 0 0-16 16v128a16 16 0 0 0 16 16h192a16 16 0 0 0 16-16V64a16 16 0 0 0-16-16m0 16v24H32V64Zm0 128H32v-88h192zm-16-24a8 8 0 0 1-8 8h-32a8 8 0 0 1 0-16h32a8 8 0 0 1 8 8m-64 0a8 8 0 0 1-8 8h-16a8 8 0 0 1 0-16h16a8 8 0 0 1 8 8',
  calendarX:
    'M208 32h-24v-8a8 8 0 0 0-16 0v8H88v-8a8 8 0 0 0-16 0v8H48a16 16 0 0 0-16 16v160a16 16 0 0 0 16 16h160a16 16 0 0 0 16-16V48a16 16 0 0 0-16-16M72 48v8a8 8 0 0 0 16 0v-8h80v8a8 8 0 0 0 16 0v-8h24v32H48V48Zm136 160H48V96h160zm-50.34-74.34L139.31 152l18.35 18.34a8 8 0 0 1-11.32 11.32L128 163.31l-18.34 18.35a8 8 0 0 1-11.32-11.32L116.69 152l-18.35-18.34a8 8 0 0 1 11.32-11.32L128 140.69l18.34-18.35a8 8 0 0 1 11.32 11.32',
  clock:
    'M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24m0 192a88 88 0 1 1 88-88a88.1 88.1 0 0 1-88 88m64-88a8 8 0 0 1-8 8h-56a8 8 0 0 1-8-8V72a8 8 0 0 1 16 0v48h48a8 8 0 0 1 8 8',
  videoCamera:
    'M251.77 73a8 8 0 0 0-8.21.39L208 97.05V72a16 16 0 0 0-16-16H32a16 16 0 0 0-16 16v112a16 16 0 0 0 16 16h160a16 16 0 0 0 16-16v-25l35.56 23.71A8 8 0 0 0 248 184a8 8 0 0 0 8-8V80a8 8 0 0 0-4.23-7M192 184H32V72h160zm48-22.95l-32-21.33v-23.44L240 95Z',
};

// Formación agrupada: el icono va en el título de cada grupo. `detalle` se pinta a
// continuación del título, en la misma línea y en letra pequeña. La suma de las
// tres tarjetas debe seguir midiendo lo mismo que el texto de la izquierda, así
// que cada línea de más cuenta (Docencia admite hasta 4 líneas a 1280 px).
const formacionGrupos: {
  icono: string;
  titulo: string;
  items: { titulo: string; detalle?: string }[];
}[] = [
  {
    icono: 'graduationCap',
    titulo: 'Educación',
    items: [
      {
        titulo: 'Licenciatura en Psicología',
        detalle: 'Univ. del Salvador · 2013 a 2017',
      },
      { titulo: 'Máster en Psicología General Sanitaria', detalle: 'Homologado en 2024' },
    ],
  },
  {
    icono: 'certificate',
    titulo: 'Formación clínica',
    items: [
      { titulo: 'EMDR Nivel 1', detalle: 'Inst. Español de EMDR' },
      { titulo: 'Terapia Cognitivo Conductual', detalle: 'Univ. de Belgrano' },
      { titulo: 'Terapia Dialéctico Conductual', detalle: 'Univ. Aconcagua' },
    ],
  },
  {
    icono: 'chalkboardTeacher',
    titulo: 'Docencia',
    items: [
      {
        titulo: 'Psicología y salud mental',
        detalle:
          'Imparto clases con metodologías innovadoras, participo en proyectos de investigación sobre inteligencia artificial y colaboro en programas de salud mental.',
      },
    ],
  },
];

// Sesiones: de V1.
const paraQuienEs = [
  'Sientes ansiedad o estrés que no consigues gestionar por tu cuenta.',
  'Atraviesas un duelo o una pérdida reciente.',
  'Notas síntomas de depresión o desmotivación persistente.',
  'Eres madre, padre o tutor y buscas apoyo para un adolescente.',
  'Como pareja, queréis recuperar una forma de hablar que se ha roto.',
  'Prefieres la comodidad y la privacidad de la terapia online.',
];

const pasos = [
  {
    numero: '1',
    titulo: 'Escríbeme',
    texto:
      'Cuéntame por WhatsApp, en pocas palabras, qué te trae a terapia. Si prefieres hablar antes, empezamos con una primera llamada gratuita de 15 minutos.',
  },
  {
    numero: '2',
    titulo: 'Sesión online',
    texto:
      'Videollamada de 50 minutos, en un espacio privado y confidencial, por Google Meet, Zoom o WhatsApp.',
  },
  {
    numero: '3',
    titulo: 'Seguimiento',
    texto:
      'Avanzamos sesión a sesión, ajustando el enfoque y las herramientas a tu proceso y tu ritmo.',
  },
];

// Condiciones del servicio. No se muestran importes por decisión del cliente (ver
// CLAUDE.md): el botón de la sección remite a WhatsApp. `destacado` es un fragmento
// de `valor` que se pinta en azul y negrita.
const condiciones: { icono: string; clave: string; valor: string; destacado?: string }[] = [
  { icono: 'creditCard', clave: 'Forma de pago', valor: 'Bizum o transferencia bancaria.' },
  {
    icono: 'calendarX',
    clave: 'Cancelaciones',
    valor: 'Deben comunicarse con 48\u00a0horas de antelación.',
    destacado: '48\u00a0horas',
  },
  {
    icono: 'videoCamera',
    clave: 'Plataformas',
    valor: 'Google Meet, Zoom o WhatsApp, a tu elección.',
  },
  { icono: 'clock', clave: 'Horarios', valor: 'Amplia disponibilidad horaria.' },
];

const enfoques = [
  {
    titulo: 'TCC (Terapia Cognitivo-Conductual)',
    texto:
      'Parte de una idea sencilla: no son los hechos los que nos hacen sufrir, sino cómo los interpretamos y lo que hacemos a partir de ahí. Es un enfoque práctico y estructurado: identificamos juntos esos pensamientos que no te ayudan, como pensar "todo me va a salir mal" tras un solo contratiempo, y los sustituimos por formas de pensar más realistas. También vamos cambiando, poco a poco, los comportamientos que mantienen tu malestar, como evitar situaciones por miedo. Es especialmente eficaz para la ansiedad, la depresión y el estrés, y suele dar resultados visibles en relativamente poco tiempo.',
  },
  {
    titulo: 'EMDR',
    texto:
      'Es una terapia que ayuda a tu cerebro a "digerir" recuerdos o experiencias difíciles que se han quedado atascados y te siguen afectando en el presente, aunque haya pasado tiempo: ansiedad, pesadillas o reacciones desproporcionadas ante ciertas situaciones. Durante la sesión, mientras recuerdas brevemente esa experiencia, te guío a través de un tipo de estimulación (normalmente con movimientos oculares) que ayuda a tu cerebro a procesar ese recuerdo de una forma más sana. No se trata de olvidar lo ocurrido, sino de que deje de doler y de condicionar tu día a día.',
  },
];

const faqs = [
  {
    pregunta: '¿La terapia online es tan eficaz como la presencial?',
    respuesta:
      'Sí: la evidencia respalda que la terapia por videollamada logra resultados comparables a la presencial, como en la ansiedad, la depresión o el estrés. Solo necesitas una conexión estable y un sitio donde puedas hablar con tranquilidad.',
  },
  {
    pregunta: '¿Qué problemas trabajas y desde qué enfoque?',
    respuesta:
      'Trabajo la ansiedad, el estrés, el duelo y la depresión, y acompaño a adolescentes y a parejas. Combino la terapia cognitivo-conductual, práctica y estructurada, con EMDR para recuerdos difíciles que te siguen afectando. Ajusto las herramientas a tu proceso y a tu ritmo.',
  },
  {
    pregunta: '¿En qué casos no es recomendable la terapia online?',
    respuesta:
      'No es el recurso adecuado en una crisis o emergencia, si hay riesgo de autolesión o de hacer daño a otras personas, ni cuando hace falta atención presencial o psiquiátrica urgente. En esos casos, llama al 024 (atención a la conducta suicida) o al 112 (emergencias); si sufres violencia de género, al 016. Y si dudas de si tu caso encaja, cuéntamelo y te oriento con honestidad.',
  },
  {
    pregunta: '¿Estás colegiado y tienes habilitación sanitaria?',
    respuesta:
      'Soy Licenciado en Psicología por la Universidad del Salvador y Psicólogo General Sanitario en España, por título homologado en 2024. Estoy colegiado con el número 68849 en Argentina. Puedes encontrarme en el Buscador Nacional de Profesionales de la Salud.',
    // Este tramo de la respuesta se pinta como enlace
    enlace: {
      texto: 'Buscador Nacional de Profesionales de la Salud',
      href: 'https://www.argentina.gob.ar/salud/buscador-nacional-de-profesionales-de-la-salud',
    },
  },
  {
    pregunta: '¿Cómo reservo la primera cita?',
    respuesta:
      'Escríbeme por WhatsApp desde el botón de esta página o desde la sección de contacto, y cuéntame en pocas palabras qué te trae. Si prefieres hablar antes, empezamos con una primera llamada gratuita de 15 minutos, sin compromiso. Después acordamos juntos el día y la hora.',
  },
  {
    pregunta: '¿Es confidencial? ¿Se graban las sesiones?',
    respuesta:
      'Sí, todo lo que hablemos es confidencial. Estoy sujeto al secreto profesional y al código deontológico de la psicología, y trato tus datos conforme al RGPD. Las sesiones no se graban.',
  },
  {
    pregunta: '¿Cuánto duran las sesiones y con qué frecuencia?',
    respuesta:
      'Las sesiones, individuales o de pareja, duran 50 minutos y tengo amplia disponibilidad horaria. La frecuencia no es fija: la ajustamos a tu proceso y a tu ritmo.',
  },
  {
    pregunta: '¿Qué plataforma de videollamada usas y qué necesito?',
    respuesta:
      'Hacemos la sesión por Google Meet, Zoom o WhatsApp, a tu elección. Necesitas un dispositivo con cámara y micrófono, una buena conexión y un espacio tranquilo y privado donde puedas hablar con libertad. Te recomiendo usar auriculares.',
  },
  {
    pregunta: '¿Cuánto cuesta la sesión?',
    respuesta:
      'Los precios no aparecen en la web: prefiero dártelos en contacto directo, por WhatsApp, para explicarte cómo funciona y resolver tus dudas sin compromiso. El importe depende de si la sesión es individual o de pareja. Escríbeme cuando quieras y lo hablamos con calma.',
  },
  {
    pregunta: '¿Cómo se paga?',
    respuesta:
      'Puedes pagar por Bizum o transferencia bancaria. Si tienes cualquier duda, escríbeme y lo resolvemos.',
  },
  {
    pregunta: '¿Cuál es la política de cancelación?',
    respuesta:
      'Entiendo que a veces surgen imprevistos: solo te pido que me avises con 48 horas de antelación.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
  })),
};
---

<Base title={title} description={description} noindex>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(faqJsonLd)}
  ></script>
  <Header />

  <main class="text-ink">
    <!-- Hero: estructura de V2, textos y color de V1 -->
    <section id="inicio" class="bg-navy-800 px-6 pt-14 pb-20 text-cream-50 sm:pt-20 sm:pb-28">
      <div class="mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-2">
        <div>
          <!-- Tamaño en cqw: escala con el ancho de la columna para que la primera línea (nombre y título) quepa entera; tope en 14px -->
          <div class="@container">
            <p class="animate-hero-in font-serif text-[length:min(0.875rem,2.8cqw)] tracking-[0.1em] text-gold-400 uppercase">
              Juan Ignacio Riccardi · Psicólogo General Sanitario
              <br />
              Colegiado nº 68849
            </p>
          </div>
          <h1 class="animate-hero-in mt-4 font-serif text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">
            Psicólogo online para la ansiedad, el estrés y el duelo
          </h1>
          <p class="animate-hero-in mt-5 max-w-lg text-lg text-cream-50/85 [animation-delay:80ms]">
            Acompaño a adolescentes, adultos y parejas en procesos de ansiedad, estrés, duelo y
            depresión. Sesiones de 50 minutos por videollamada, con herramientas con aval
            científico, entre ellas EMDR.
          </p>
          <div class="animate-hero-in mt-8 flex flex-wrap items-center gap-4 [animation-delay:160ms]">
            <a
              href={llamadaHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-md bg-cream-50 px-6 py-3 text-center font-medium text-balance text-navy-800 transition-transform duration-150 ease-[var(--ease-out)] hover:scale-[1.02] active:scale-[0.98]"
            >
              Pide tu llamada gratuita de 15 minutos
            </a>
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-cream-50/80 underline decoration-gold-400 underline-offset-4 hover:text-cream-50"
            >
              O escríbeme por WhatsApp
            </a>
          </div>
          <ul class="animate-hero-in mt-8 flex flex-wrap gap-x-6 gap-y-2 text-xs tracking-[0.12em] text-cream-50/70 uppercase [animation-delay:200ms]">
            {confianza.map((item) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-4 shrink-0 bg-gold-400" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
          <p class="animate-hero-in mt-6 text-xs text-cream-50/60 [animation-delay:220ms]">
            Todo lo que compartas queda protegido por el secreto profesional.
          </p>
        </div>

        <div class="animate-hero-in [animation-delay:120ms]">
          <img
            src={fotoCuadrada}
            alt="Juan Ignacio Riccardi, Psicólogo General Sanitario"
            width="900"
            height="900"
            class="v2-blob-1 mx-auto aspect-square w-full max-w-md border border-navy-600 object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Sobre mí (texto de V1) con la formación de V3 dentro -->
    <section id="sobre-mi" class="bg-white px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <h2 data-reveal class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">
          Sobre mí
        </h2>

        <div class="mt-6 grid gap-x-12 gap-y-8 md:grid-cols-2">
          <div data-reveal class="flex flex-col justify-between gap-4">
            <p class="leading-relaxed text-ink/80">
              Soy Juan Ignacio Riccardi, Licenciado en Psicología y Psicólogo General Sanitario.
              Ejerzo desde 2017 y acompaño a adolescentes, adultos y parejas en procesos de
              ansiedad, estrés, duelo y depresión.
            </p>
            <p class="leading-relaxed text-ink/80">
              Combino dos enfoques con base científica: la Terapia Cognitivo-Conductual (TCC), para
              trabajar los pensamientos y comportamientos que mantienen el malestar, y EMDR, para
              procesar traumas y experiencias difíciles.
            </p>
            <p class="leading-relaxed text-ink/80">
              Mi trayectoria une la clínica y la educación. Llevo consulta privada, he acompañado a
              personas con discapacidad a través de obras sociales, he formado parte de equipos de
              orientación escolar y programas de inclusión, y doy clase en nivel secundario y
              superior en materias de psicología y salud mental.
            </p>
            <p class="leading-relaxed text-ink/80">
              Todo el proceso ocurre online, en un espacio cercano, confidencial y sin juicios,
              desde donde te resulte más cómodo.
            </p>
          </div>

          <div id="formacion" data-reveal-group class="flex scroll-mt-24 flex-col gap-4">
            {formacionGrupos.map((grupo) => (
              <div class="flex-auto rounded-2xl border border-navy-100 bg-cream-50 p-4">
                <h3 class="flex items-center gap-2 font-serif text-sm font-semibold tracking-[0.16em] text-navy-800 uppercase">
                  <svg
                    viewBox="0 0 256 256"
                    fill="currentColor"
                    class="h-5 w-5 shrink-0 text-navy-600"
                    aria-hidden="true"
                  >
                    <path d={iconosPh[grupo.icono]} />
                  </svg>
                  {grupo.titulo}
                </h3>
                <ul class="mt-3 grid gap-2">
                  {grupo.items.map((item) => (
                    <li class="text-sm">
                      <span class="font-medium text-navy-800">{item.titulo}</span>
                      {item.detalle && (
                        <>
                          {' '}
                          <span class="ml-1 text-xs text-ink/70">{item.detalle}</span>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <p data-reveal class="text-sm leading-relaxed text-ink/70 md:col-start-2">
            Puedes consultar mi trayectoria completa en{' '}
            <a
              href={linkedinHref}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-gold-400 underline-offset-4 hover:text-navy-600"
            >
              LinkedIn
            </a>
            .
          </p>
        </div>
      </div>
    </section>

    <!-- Servicios (V2) -->
    <section id="servicios" class="bg-cream-50 px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-xl">
          <h2 class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">
            Cómo puedo ayudarte
          </h2>
          <p class="mt-3 text-ink/80">
            Sesiones online para adolescentes, adultos y parejas. Cada proceso es distinto, así que
            buscamos juntos lo que a ti te funciona.
          </p>
        </div>

        <div data-reveal-group class="mt-10 grid gap-6 sm:grid-cols-2">
          {servicios.map((servicio, i) => (
            <div
              class:list={[
                'rounded-3xl border border-navy-100 bg-white p-7 shadow-[0_16px_40px_-24px_rgba(42,63,106,0.35)]',
                { 'sm:mt-6': i % 2 === 1 },
              ]}
            >
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-navy-100">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6 text-navy-800"
                  aria-hidden="true"
                >
                  {iconos[servicio.titulo].map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </div>
              <h3 class="mt-4 font-serif text-lg font-semibold text-navy-800">{servicio.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{servicio.texto}</p>
            </div>
          ))}
        </div>

        <h3 data-reveal class="mt-16 font-serif text-xl font-semibold text-navy-800 sm:text-2xl">
          ¿Bajo qué enfoque trabajo?
        </h3>

        <div data-reveal-group class="mt-8 grid gap-6 sm:grid-cols-2">
          {enfoques.map((enfoque) => (
            <div class="rounded-3xl border border-navy-100 bg-white p-7 shadow-[0_16px_40px_-24px_rgba(42,63,106,0.35)]">
              <h4 class="font-serif text-lg font-semibold text-navy-800">{enfoque.titulo}</h4>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{enfoque.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sesiones: Sesiones (V1) y Tarifas (V3) en una sola sección -->
    <section id="como-funciona" class="bg-white px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="max-w-2xl">
          <h2 class="font-serif text-2xl font-semibold text-balance text-navy-800 sm:text-3xl">
            Sesiones
          </h2>
          <p class="mt-3 text-pretty text-ink/80">
            Ofrezco dos modalidades de sesión, individual y de pareja, con una duración de
            50&nbsp;minutos y en formato de videollamada.
          </p>
        </div>

        <div data-reveal-group class="mt-12 grid gap-12 md:grid-cols-2">
          <div class="flex flex-col">
            <h3 class="font-serif text-xl font-semibold text-balance text-navy-800">
              ¿Es esto para ti?
            </h3>
            <ul class="mt-6 flex flex-1 flex-col justify-between gap-3">
              {paraQuienEs.map((item) => (
                <li class="flex items-start gap-3 text-ink/80">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="font-serif text-xl font-semibold text-balance text-navy-800">
              Qué esperar de una sesión online
            </h3>
            <ol class="mt-6">
              {pasos.map((paso, i) => (
                <li class:list={['relative flex gap-4', { 'pb-8': i < pasos.length - 1 }]}>
                  {i < pasos.length - 1 && (
                    <span
                      class="absolute top-10 bottom-0 left-5 w-px bg-navy-100"
                      aria-hidden="true"
                    />
                  )}
                  <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy-800 font-serif text-lg font-semibold text-cream-50">
                    {paso.numero}
                  </span>
                  <div>
                    <h4 class="font-semibold text-navy-800">{paso.titulo}</h4>
                    <p class="mt-1 text-sm leading-relaxed text-ink/70">{paso.texto}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div
          data-reveal
          class="mt-12 overflow-hidden rounded-2xl border border-navy-100 bg-cream-50"
        >
          <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
            <h3 class="font-serif text-xl font-semibold text-balance text-navy-800">
              Condiciones del servicio
            </h3>
            <a
              href={tarifaHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Consultar tarifa por WhatsApp"
              class={`inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-navy-800 px-3 py-2 text-base font-semibold text-cream-50 transition-transform duration-300 ${curva} hover:scale-[1.02] active:scale-[0.98] ${foco}`}
            >
              <svg
                viewBox="0 0 256 256"
                fill="currentColor"
                class="h-5 w-5 shrink-0"
                aria-hidden="true"
              >
                <path d={iconoWhatsApp} />
              </svg>
              Consultar tarifa
            </a>
          </div>

          <ul class="grid gap-px border-t border-navy-100 bg-navy-100 sm:grid-cols-2 lg:grid-cols-4">
            {condiciones.map((condicion) => (
              <li class="flex gap-4 bg-cream-50 p-6 sm:block">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy-100">
                  <svg
                    viewBox="0 0 256 256"
                    fill="currentColor"
                    class="h-6 w-6 text-navy-800"
                    aria-hidden="true"
                  >
                    <path d={iconosPh[condicion.icono]} />
                  </svg>
                </div>
                <div class="sm:mt-4">
                  <p class="text-xs tracking-[0.12em] text-ink/70 uppercase">{condicion.clave}</p>
                  <p class="mt-2 text-sm text-pretty text-ink/80">
                    {condicion.destacado ? (
                      <>
                        {condicion.valor.split(condicion.destacado)[0]}
                        <strong class="font-bold text-navy-800">{condicion.destacado}</strong>
                        {condicion.valor.split(condicion.destacado)[1]}
                      </>
                    ) : (
                      condicion.valor
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Preguntas frecuentes (V3) -->
    <section id="faq" class="bg-cream-50 px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 data-reveal class="font-serif text-2xl font-semibold text-navy-800 sm:text-3xl">
          Preguntas frecuentes
        </h2>

        <div
          data-reveal-group
          class="mt-10 divide-y divide-navy-100 border-t border-b border-navy-100"
        >
          {faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg font-semibold text-navy-800 marker:hidden">
                {faq.pregunta}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4 shrink-0 text-navy-600 transition-transform duration-200 ease-[var(--ease-out)] group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">
                {faq.enlace ? (
                  <>
                    {faq.respuesta.split(faq.enlace.texto)[0]}
                    <a
                      href={faq.enlace.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-gold-400 underline-offset-4 hover:text-navy-600"
                    >
                      {faq.enlace.texto}
                    </a>
                    {faq.respuesta.split(faq.enlace.texto)[1]}
                  </>
                ) : (
                  faq.respuesta
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <Contacto />
  </main>

  <WhatsAppFloat href={whatsappHref} etiqueta="Hablemos" />

  <Revelar />
</Base>
