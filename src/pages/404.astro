---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/withBase';
---

<Base title="Página no encontrada · Clínica Conecta" description="Página no encontrada." noindex>
  <Header />

  <main class="mx-auto max-w-5xl px-6 py-24 text-center">
    <h1 class="text-3xl font-bold text-slate-900">Página no encontrada</h1>
    <p class="mt-4 text-slate-600">La página que buscas no existe o se ha movido.</p>
    <a href={withBase('/')} class="mt-6 inline-block text-brand-600 underline">
      Volver al inicio
    </a>
  </main>

  <Footer />
</Base>
