---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/withBase';
---

<Base title="Página no encontrada · Clínica Conecta" description="Página no encontrada." noindex>
  <Header />

  <main class="mx-auto max-w-5xl px-6 py-24 text-center text-ink">
    <h1 class="font-serif text-3xl font-semibold text-navy-800 sm:text-4xl">
      Página no encontrada
    </h1>
    <p class="mt-4 text-ink/80">La página que buscas no existe o se ha movido.</p>
    <a
      href={withBase('/')}
      class="mt-6 inline-block text-navy-600 underline decoration-gold-400 underline-offset-4 hover:text-navy-800"
    >
      Volver al inicio
    </a>
  </main>

  <Footer />
</Base>
