{
  // El sitio como Worker, servido en el dominio propio del cliente.
  // `workers_dev` está apagado: el dominio (apex y www, ver `routes`) ya sirve
  // la web, así que el subdominio de workers.dev solo habría sido una segunda
  // URL pública con el mismo contenido. Si algún día falla el DNS del dominio y
  // hace falta una vía de emergencia, ponerlo a true y desplegar.
  "name": "clinica-conecta",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,

  // `custom_domain` hace que Cloudflare cree y gestione el registro DNS, pero
  // la zona juanriccardiconecta.com tiene que existir ya en la misma cuenta
  // de Cloudflare — si no, el deploy falla aquí. Se sirve tanto el dominio sin
  // www como www; el `canonical` de todas las páginas apunta al primero
  // (SITE_URL en deploy-cloudflare.yml), así que no compiten en buscadores.
  // Si ya existiera un registro DNS manual para www, hay que borrarlo antes:
  // Wrangler no lo sobrescribe.
  "routes": [
    { "pattern": "juanriccardiconecta.com", "custom_domain": true },
    { "pattern": "www.juanriccardiconecta.com", "custom_domain": true },
  ],

  // dist/ se construye en CI y no se versiona.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
